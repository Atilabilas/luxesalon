@page
@model IndexModel
@{
    ViewData["Title"] = "Celil Kuaför | Premium Saç Tasarım Stüdyosu";
}

@* ═══════════════════════════════════════════════════════════════════════════════
   SECTION 1: HERO - Full Screen with Video/Image Background
═══════════════════════════════════════════════════════════════════════════════ *@
<section class="relative h-screen flex items-center justify-center overflow-hidden group">
    @* Edit Button *@
    @if (User.Identity.IsAuthenticated)
    {
        <a href="/Admin/Content" 
           class="admin-edit-btn opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute top-24 right-6 z-50 bg-luxe-gold text-white text-xs px-4 py-2 font-medium hover:bg-luxe-charcoal shadow-lg flex items-center gap-2">
            <i class="fas fa-edit"></i> Hero Düzenle
        </a>
    }
    
    @* Background Image with Parallax *@
    <div class="absolute inset-0 z-0 parallax-bg">
        <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?q=80&w=1920&auto=format&fit=crop" 
             alt="Salon Background" 
             class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-luxe-charcoal/50"></div>
    </div>

    @* Hero Content *@
    <div class="relative z-10 text-center text-white px-6">
        <p class="text-sm md:text-base uppercase tracking-[0.4em] text-white font-medium mb-8 reveal">@Model.GetContent("hero_subtitle", "PREMIUM SAÇ TASARIM STÜDYOSU")</p>
        <h1 class="text-6xl md:text-8xl lg:text-[10rem] font-serif leading-[0.85] mb-12 reveal">
            Celil<br/><span class="italic font-light">Kuaför</span>
        </h1>
        <div class="flex flex-col md:flex-row items-center justify-center gap-6 reveal">
            <a href="#randevu" class="btn-white">@Model.GetContent("hero_cta_appointment", "RANDEVU AL")</a>
            <a href="#hizmetler" class="bg-transparent border-2 border-white text-white px-10 py-5 text-[11px] uppercase font-bold tracking-[0.3em] transition-all duration-500 hover:bg-white hover:text-luxe-charcoal">@Model.GetContent("hero_cta_services", "HİZMETLERİMİZ")</a>
        </div>
    </div>

    @* Scroll Indicator *@
    <div class="absolute bottom-12 left-1/2 -translate-x-1/2 z-10 text-white text-center reveal hidden md:block">
        <p class="text-sm uppercase tracking-[0.3em] mb-4 text-white/80">@Model.GetContent("hero_scroll", "Keşfet")</p>
        <div class="w-[1px] h-16 bg-white/60 mx-auto animate-bounce"></div>
    </div>

    @* ═══════════════════════════════════════════════════════════════════════════════
       QUICK APPOINTMENT BAR (Floating)
    ═══════════════════════════════════════════════════════════════════════════════ *@
    <div x-data="appointmentForm()" class="absolute bottom-0 w-full z-30 transform translate-y-1/2 md:translate-y-0 md:bottom-10 px-6">
        <div class="container mx-auto">
            <div class="bg-white/10 backdrop-blur-md border border-white/20 p-4 md:p-6 shadow-2xl rounded-none md:rounded-lg">
                <form x-on:submit.prevent="checkAvailability" class="flex flex-col md:flex-row items-center gap-4">
                    @* Date *@
                    <div class="w-full md:w-1/4 relative">
                        <i class="fas fa-calendar absolute left-4 top-1/2 -translate-y-1/2 text-white/60"></i>
                        <input x-model="form.date" type="date" required min="@DateTime.Now.ToString("yyyy-MM-dd")"
                               class="w-full bg-black/20 border border-white/10 text-white pl-12 pr-4 py-3 focus:outline-none focus:border-luxe-gold transition-colors placeholder-white/50" />
                    </div>
                    
                    @* Time *@
                    <div class="w-full md:w-1/4 relative">
                        <i class="fas fa-clock absolute left-4 top-1/2 -translate-y-1/2 text-white/60"></i>
                        <select x-model="form.time" required class="w-full bg-black/20 border border-white/10 text-white pl-12 pr-4 py-3 focus:outline-none focus:border-luxe-gold transition-colors appearance-none cursor-pointer">
                            <option value="" class="text-black">Saat Seçin</option>
                            @for(int i=9; i<20; i++)
                            {
                                <option value="@i:00" class="text-black">@i:00</option>
                                <option value="@i:30" class="text-black">@i:30</option>
                            }
                        </select>
                    </div>

                    @* Email *@
                    <div class="w-full md:w-1/3 relative">
                        <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-white/60"></i>
                        <input x-model="form.email" type="email" placeholder="E-posta Adresiniz" required
                               class="w-full bg-black/20 border border-white/10 text-white pl-12 pr-4 py-3 focus:outline-none focus:border-luxe-gold transition-colors placeholder-white/50" />
                    </div>

                    @* Submit *@
                    <button type="submit" :disabled="loading" class="w-full md:w-auto px-8 py-3 bg-luxe-gold hover:bg-white hover:text-luxe-charcoal text-white font-medium tracking-widest transition-all duration-300 disabled:opacity-50">
                        <span x-show="!loading">DEVAM</span>
                        <span x-show="loading"><i class="fas fa-spinner fa-spin"></i></span>
                    </button>
                </form>
            </div>
        </div>

        @* ════════════════════════════════════════════════════════════════════════
           MODAL - Complete Appointment
        ════════════════════════════════════════════════════════════════════════ *@
        <div x-show="modalOpen" style="display: none;" 
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm">
            
            <div x-on:click.away="modalOpen = false" class="bg-white w-full max-w-md p-8 relative shadow-2xl border-t-4 border-luxe-gold">
                <button x-on:click="modalOpen = false" class="absolute top-4 right-4 text-gray-400 hover:text-red-500">
                    <i class="fas fa-times text-xl"></i>
                </button>
                
                <h3 class="font-serif text-2xl mb-2 text-luxe-charcoal">Randevuyu Tamamla</h3>
                <p class="text-gray-500 text-sm mb-6">Lütfen iletişim bilgilerinizi doğrulayın.</p>
                
                <form x-on:submit.prevent="completeAppointment" class="space-y-4">
                    <div>
                        <label class="block text-xs uppercase tracking-widest text-gray-500 mb-1">Ad Soyad</label>
                        <input x-model="form.name" type="text" required class="w-full border border-gray-300 p-3 focus:outline-none focus:border-luxe-gold" placeholder="Tam adınız" />
                    </div>
                    <div>
                        <label class="block text-xs uppercase tracking-widest text-gray-500 mb-1">Telefon</label>
                        <input x-model="form.phone" type="tel" required class="w-full border border-gray-300 p-3 focus:outline-none focus:border-luxe-gold" placeholder="05XX XXX XX XX" />
                    </div>
                    
                    <div x-show="errorMessage" class="p-3 bg-red-100 text-red-600 text-sm" x-text="errorMessage"></div>
                    <div x-show="successMessage" class="p-3 bg-green-100 text-green-600 text-sm" x-text="successMessage"></div>

                    <button type="submit" :disabled="submitting" class="w-full btn-primary py-3 mt-4">
                        <span x-show="!submitting">RANDEVUYU ONAYLA</span>
                        <span x-show="submitting">İŞLENİYOR...</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
<script>
    function appointmentForm() {
        return {
            form: {
                date: '',
                time: '',
                email: '',
                name: '',
                phone: ''
            },
            modalOpen: false,
            loading: false,
            submitting: false,
            errorMessage: '',
            successMessage: '',

            async checkAvailability() {
                this.loading = true;
                this.errorMessage = '';
                try {
                    const response = await fetch('/api/appointments/check-availability', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            date: this.form.date,
                            time: this.form.time
                        })
                    });
                    
                    const data = await response.json();
                    
                    if (response.ok) {
                        this.modalOpen = true;
                    } else {
                        alert(data.message || 'Bir hata oluştu.');
                    }
                } catch (e) {
                    alert('Sistem hatası. Lütfen tekrar deneyin.');
                } finally {
                    this.loading = false;
                }
            },

            async completeAppointment() {
                this.submitting = true;
                this.errorMessage = '';
                this.successMessage = '';
                
                try {
                    const response = await fetch('/api/appointments/create', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(this.form)
                    });
                    
                    const data = await response.json();
                    
                    if (response.ok) {
                        this.successMessage = data.message;
                        setTimeout(() => {
                            this.modalOpen = false;
                            this.form.name = ''; 
                            this.form.phone = '';
                            this.form.email = '';
                            this.successMessage = '';
                        }, 2000);
                    } else {
                        this.errorMessage = data.message || 'Rezervasyon oluşturulamadı.';
                    }
                } catch (e) {
                    this.errorMessage = 'Bağlantı hatası.';
                } finally {
                    this.submitting = false;
                }
            }
        }
    }
</script>

