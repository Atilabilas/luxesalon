@* ═══════════════════════════════════════════════════════════════════════════════
   SECTION 4: PRICING - Elegant Price List
═══════════════════════════════════════════════════════════════════════════════ *@
<section class="section-padding bg-luxe-charcoal text-white">
    <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-32">
            @* Left: Title & Image *@
            <div class="reveal-left">
                <p class="text-sm uppercase tracking-[0.3em] text-luxe-gold font-bold mb-4">Fiyat Listesi</p>
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-serif font-semibold text-white mb-12">
                    Şeffaf<br/><span class="italic font-light">Fiyatlar</span>
                </h2>
                <div class="aspect-[4/3] overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?q=80&w=800&auto=format&fit=crop" 
                         alt="Salon" class="w-full h-full object-cover opacity-80" />
                </div>
            </div>

            @* Right: Price List *@
            <div class="reveal-right">
                @if (Model.PriceItems.Any())
                {
                    @foreach (var category in Model.PriceCategories)
                    {
                        <div class="mb-12">
                            <h3 class="text-xl md:text-2xl font-serif font-semibold mb-8 text-luxe-gold">@category</h3>
                            @foreach (var item in Model.PriceItems.Where(p => p.Category == category))
                            {
                                <div class="price-item border-white/10 hover:border-luxe-gold">
                                    <span class="text-base md:text-lg font-medium">@item.ServiceName</span>
                                    <span class="price-dots border-white/10"></span>
                                    <span class="text-luxe-gold font-serif text-xl md:text-2xl font-semibold">₺@item.Price.ToString("N0")</span>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    @* Default prices when database is empty *@
                    <div class="mb-12">
                        <h3 class="text-xl md:text-2xl font-serif font-semibold mb-8 text-luxe-gold">Saç Hizmetleri</h3>
                        <div class="price-item border-white/10 hover:border-luxe-gold">
                            <span class="text-base md:text-lg font-medium">Kadın Saç Kesimi</span>
                            <span class="price-dots border-white/10"></span>
                            <span class="text-luxe-gold font-serif text-xl md:text-2xl font-semibold">₺800</span>
                        </div>
                        <div class="price-item border-white/10 hover:border-luxe-gold">
                            <span class="text-base md:text-lg font-medium">Erkek Saç Kesimi</span>
                            <span class="price-dots border-white/10"></span>
                            <span class="text-luxe-gold font-serif text-xl md:text-2xl font-semibold">₺400</span>
                        </div>
                    </div>
                    <div class="mb-12">
                        <h3 class="text-xl md:text-2xl font-serif font-semibold mb-8 text-luxe-gold">Renk Hizmetleri</h3>
                        <div class="price-item border-white/10 hover:border-luxe-gold">
                            <span class="text-base md:text-lg font-medium">Balayage</span>
                            <span class="price-dots border-white/10"></span>
                            <span class="text-luxe-gold font-serif text-xl md:text-2xl font-semibold">₺3.500</span>
                        </div>
                    </div>
                    <div>
                        <h3 class="text-xl md:text-2xl font-serif font-semibold mb-8 text-luxe-gold">Bakım</h3>
                        <div class="price-item border-white/10 hover:border-luxe-gold">
                            <span class="text-base md:text-lg font-medium">Keratin Bakım</span>
                            <span class="price-dots border-white/10"></span>
                            <span class="text-luxe-gold font-serif text-xl md:text-2xl font-semibold">₺2.500</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@* ═══════════════════════════════════════════════════════════════════════════════
   SECTION 5: TEAM - Our Stylists
═══════════════════════════════════════════════════════════════════════════════ *@
<section class="section-padding bg-luxe-ivory relative group">
    @* Edit Button *@
    @if (User.Identity.IsAuthenticated)
    {
        <a href="/Admin/Team" 
           class="admin-edit-btn opacity-0 group-hover:opacity-100 transition-opacity duration-300 absolute top-6 right-6 z-50 bg-luxe-gold text-white text-xs px-4 py-2 font-medium hover:bg-luxe-charcoal shadow-lg flex items-center gap-2">
            <i class="fas fa-edit"></i> Ekip Düzenle
        </a>
    }
    
    <div class="container mx-auto">
        <div class="text-center mb-20 reveal">
            <p class="section-subtitle">@Model.GetContent("team_subtitle", "EKİBİMİZ")</p>
            <h2 class="section-title">@Model.GetContent("team_title", "Uzman Stilistler")</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            @if (Model.TeamMembers.Any())
            {
                @foreach (var member in Model.TeamMembers)
