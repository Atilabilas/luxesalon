@page
@model IndexModel
@using LuxeSalon.Web.Services
@{
    var culture = Model.CurrentCulture;
    var en = Model.IsEnglish;
    var appointmentPath = SitePaths.Appointment(culture);
    var heroSrc = ContentImageCatalog.Resolve(Model.HeroImage?.ImageUrl ?? "/images/services/kadin-kesim.jpg");
    var heroIllustrative = ContentImageCatalog.Alt(heroSrc, culture) != null;
    var cards = new[] { (Slug: "kadin-sac-kesimi", Key: 1), (Slug: "balyaj-ombre-sombre", Key: 2), (Slug: "keratin-sac-botoksu", Key: 3) };
    Model.SetSeo(
        en ? LocalHeadTerms.HomeTitleEn : LocalHeadTerms.HomeTitleTr,
        en ? LocalHeadTerms.HomeDescriptionEn : LocalHeadTerms.HomeDescriptionTr,
        SitePaths.Home(culture), heroSrc, "website", null, "/", "/en");
}

<section class="home-hero home-container" aria-labelledby="hero-heading">
    <div class="home-hero-copy">
        <p class="home-eyebrow">Bornova / İzmir</p>
        <h1 id="hero-heading">@(en ? LocalHeadTerms.HomeFocusEn : LocalHeadTerms.HomeFocusTr)<span class="home-hero-focus">Celil &amp; Atilla</span></h1>
        <p class="home-hero-description">@(en ? LocalHeadTerms.HomeSupportEn : LocalHeadTerms.HomeSupportTr) <a href="@SitePaths.Districts(culture)">@(en ? "İzmir districts" : "İzmir ilçeleri")</a></p>
        <p class="home-hero-description">@Model.GetContent("hero_description")</p>
        <div class="home-hero-actions">
            <a href="@appointmentPath" class="home-button">@Model.GetContent("hero_cta_appointment", en ? "Book a visit" : "Randevu oluştur")</a>
            <a href="#hizmetler" class="home-link home-explore">@(en ? "Explore the services" : "Hizmetleri keşfet") <span aria-hidden="true">→</span></a>
        </div>
        <p class="home-location"><span aria-hidden="true">⌖</span>@Model.Setting("Contact_Address") · @(en ? "Bornova, İzmir" : "Bornova / İzmir")</p>
    </div>
    <figure class="home-hero-photo">
        <img src="@heroSrc" alt="@(Model.HeroImage?.AltText ?? (en ? "Salon interior" : "Salon iç mekânı"))" fetchpriority="high" loading="eager" sizes="(max-width: 767px) calc(100vw - 40px), 314px" />
        <figcaption><span>@(en ? "CUT · COLOUR · CARE" : "KESİM · RENK · BAKIM")</span><span>@(heroIllustrative ? (en ? "Illustrative image" : "Temsili görsel") : "Celil & Atilla")</span></figcaption>
        @if (User.Identity?.IsAuthenticated == true && Model.HeroImage != null)
        {
            ViewData["EditUrl"] = $"/Admin/SiteImages/Edit/{Model.HeroImage.Id}";
            <partial name="_EditButton" />
        }
    </figure>
</section>

<section class="home-services home-container" id="hizmetler" aria-labelledby="services-heading">
    <div class="home-heading"><h2 id="services-heading">@(en ? "Bornova hair services." : "Bornova kuaför hizmetleri.")</h2><a href="@SitePaths.Services(culture)" class="home-link">@(en ? "All services" : "Tüm hizmetler") <span aria-hidden="true">↗</span></a></div>
    <div class="home-service-grid">
        @foreach (var card in cards)
        {
            var service = Model.FeaturedServices.FirstOrDefault(s => s.Slug == card.Slug);
            if (service == null) { continue; }
            <a class="home-service" href="@SitePaths.Service(culture, service.LocalizedSlug(culture))">
                <img src="@service.ImageUrl" alt="@(service.LocalizedName(culture) + (en ? " — illustrative image" : " — temsili görsel"))" loading="lazy" sizes="(max-width: 767px) 88px, (max-width: 1199px) 33vw, 400px" />
                <div><h3>@ServiceSearchCopy.VisibleName(service, culture) <span aria-hidden="true">↗</span></h3><p>@service.LocalizedDescription(culture)</p><span class="home-image-note">@(en ? "Illustrative image" : "Temsili görsel")</span></div>
            </a>
        }
    </div>
    <nav class="home-service-index" aria-label="@(en ? "All Bornova services" : "Bornova’daki tüm işlemler")">
        @foreach (var service in Model.LandingServices)
        {
            <a href="@SitePaths.Service(culture, service.LocalizedSlug(culture))">@ServiceSearchCopy.VisibleName(service, culture)</a>
        }
    </nav>
</section>

<section class="home-faq home-container" aria-labelledby="faq-heading">
    <h2 id="faq-heading">@(en ? "Bornova hair salon, before you book." : "Bornova kadın kuaförü randevusu.")</h2>
    <dl>
        <div>
            <dt>@(en ? "Where is the Bornova salon?" : "Bornova kadın kuaförü nerede?")</dt>
            <dd>@(en ? "Kazımdirik Mah. Gediz Cd. 21 A, 35100 Bornova / İzmir. Phone 0534 794 43 93." : "Kazımdirik Mah. Gediz Cd. 21 A, 35100 Bornova / İzmir. Telefon 0534 794 43 93.")</dd>
        </div>
        <div>
            <dt>@(en ? "Which services are booked here?" : "Hangi işlemler bu adreste?")</dt>
            <dd>@(en ? "Women’s haircut, balayage, ombre, sombre, keratin, hair botox, highlights, root touch-up, bridal hair, extensions, men’s fade and kids’ cuts." : "Kadın saç kesimi, balyaj, ombre, sombre, keratin, saç botoksu, röfle, kök rötuşu, gelin saçı, saç kaynağı, erkek fade ve çocuk kesimi.")</dd>
        </div>
        <div>
            <dt>@(en ? "Is there a branch in another district?" : "Başka ilçede şube var mı?")</dt>
            <dd>@(en ? "No. Guests from the other İzmir districts book this Bornova salon." : "Yok. İzmir’in diğer ilçelerinden gelenler aynı Bornova salonuna randevu alır.") <a href="@SitePaths.Districts(culture)">@(en ? "İzmir districts" : "İzmir ilçeleri")</a></dd>
        </div>
        <div>
            <dt>@(en ? "What are the hours?" : "Çalışma saatleri nedir?")</dt>
            <dd>@Model.Setting("Contact_Hours")</dd>
        </div>
    </dl>
</section>

<section class="home-story" aria-labelledby="story-heading">
    <div class="home-container"><div><h2 id="story-heading">@(en ? "In Bornova since 2000." : "2000’den beri Bornova’da.")</h2><p>@(en ? "At our only salon in Kazımdirik, Bornova, İzmir, we plan women's haircuts, balayage, ombre and hair care around your hair. We also welcome men and children." : "İzmir’in Bornova ilçesindeki Kazımdirik salonumuzda kadın saç kesimi, balyaj, ombre ve saç bakımını saçınızın yapısına göre planlıyoruz. Erkek ve çocuk randevuları da alıyoruz.")</p></div><a href="@SitePaths.About(culture)" class="home-link">@(en ? "Meet the salon & team" : "Salonu ve ekibi tanıyın") <span aria-hidden="true">↗</span></a></div>
</section>

<section class="home-booking" id="iletisim" aria-labelledby="visit-heading">
    <div class="home-container"><div><h2 id="visit-heading">@(en ? "Book the Bornova salon." : "Bornova kuaför randevusu.")</h2><p>@(en ? "Let's agree on the service and a suitable time." : "İşlemi ve uygun zamanı birlikte netleştirelim.")</p></div><div class="home-booking-actions"><a href="@appointmentPath" class="home-button home-button-light">@(en ? "Book a visit" : "Randevu al") <span aria-hidden="true">↗</span></a><a href="@WhatsAppLink.Chat(Model.Setting("Whatsapp_Number"), en ? "Hello, I would like to arrange a visit." : "Merhaba, randevu için bilgi almak istiyorum.")" class="home-link" target="_blank" rel="noopener">WhatsApp <span aria-hidden="true">↗</span></a>    </div></div>
</section>

@section Scripts {
    <script type="application/ld+json">@Html.Raw(JsonLdService.ServiceIndex(Model.LandingServices, culture, Model.SiteSettings))</script>
}
