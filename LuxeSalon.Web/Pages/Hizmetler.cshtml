@page "/hizmetler"
@model LuxeSalon.Web.Pages.HizmetlerModel
@using LuxeSalon.Web.Services
@{
    var culture = Model.CurrentCulture;
    var en = culture == "en";
    var landings = Model.Services.Where(s => s.IsLandingPage && (!en || s.HasEnglish)).ToList();
    var otherServices = Model.Services.Where(s => !s.IsLandingPage).ToList();
    Model.SetSeo(en ? ServiceSearchCopy.DirectoryTitleEn : ServiceSearchCopy.DirectoryTitleTr,
        en ? ServiceSearchCopy.DirectoryMetaEn : ServiceSearchCopy.DirectoryMetaTr,
        SitePaths.Services(culture), "/images/services/tek-renk.jpg", "website", null, SitePaths.Services("tr"), SitePaths.Services("en"));
}
<section class="atelier-page-intro services-intro">
    <div class="atelier-container">
        <p class="eyebrow">@(en ? "Services / Bornova, İzmir" : "Hizmetler / Bornova, İzmir")</p>
        <h1>@(en ? "Bornova hair" : "Bornova kuaför")<br /><em>@(en ? "services." : "hizmetleri.")</em></h1>
        <p>@(en ? "Bornova hair salon services at Gediz Cd. 21 A: cut, colour, keratin and bridal hair." : "Bornova kadın kuaförü hizmetleri Kazımdirik Mah. Gediz Cd. 21 A adresindedir. Bornova kuaför randevusu bu salondan alınır.")</p>
        <p class="local-salon-context">@(en ? "All services take place at our salon in Kazımdirik, Bornova, İzmir. Tell us which service you are considering so we can discuss its scope and a suitable appointment time." : "Hizmetlerimizi İzmir’in Bornova ilçesindeki Kazımdirik salonumuzda sunuyoruz. Düşündüğünüz işlemi bize iletin; hizmetin kapsamını ve uygun randevu zamanını birlikte konuşalım.")</p>
        <div class="hero-actions">
            <a href="@SitePaths.Appointment(culture)" class="atelier-button">@(en ? "Arrange a visit" : "Randevu al") <span aria-hidden="true">↗</span></a>
            <a href="@WhatsAppLink.Chat(Model.Setting("Whatsapp_Number"), en ? "Hello, I'd like to ask about your salon services." : "Merhaba, hizmetleriniz hakkında bilgi almak istiyorum.")" class="atelier-button outline" target="_blank" rel="noopener">@(en ? "Ask about a service" : "Hizmet hakkında sor") <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</section>

<section class="atelier-section atelier-container" aria-labelledby="salon-services">
    <div class="section-heading">
        <div><p class="eyebrow">@(en ? "Bornova / 01" : "Bornova / 01")</p><h2 id="salon-services">@(en ? "Bornova hair services." : "Bornova kadın kuaförü işlemleri.")</h2></div>
        <div class="section-aside"><p>@(en ? "Explore the service, ask your questions and request an appointment. We discuss your hair and pricing before your visit." : "İşlemi inceleyin, sorularınızı paylaşın ve randevu talep edin. Saçınıza uygun planı ve ücret bilgisini ziyaretinizden önce konuşalım.")</p></div>
    </div>
    <div class="editorial-services services-directory">
        @foreach (var service in landings)
        {
            var name = ServiceSearchCopy.VisibleName(service, culture);
            <article class="directory-card">
                <a class="editorial-service" href="@SitePaths.Service(culture, service.LocalizedSlug(culture))">
                    <figure><img src="@service.ImageUrl" alt="@name" loading="lazy" sizes="(max-width: 767px) 100vw, 33vw" /><span class="image-label">@(en ? "Explore the service" : "İşlemi incele") ↗</span></figure>
                    <div class="service-heading"><h3>@name</h3><span aria-hidden="true">↗</span></div>
                </a>
                <p>@service.LocalizedDescription(culture)</p>
                <a class="editorial-link" href="@(SitePaths.Appointment(culture) + "?serviceId=" + service.Id)">@(en ? "Request an appointment" : "Bu işlem için randevu") <span aria-hidden="true">↗</span></a>
            </article>
        }
    </div>
    <p class="image-note">@(en ? "The images illustrate the services. See our Instagram for salon work." : "Görseller hizmetleri anlatmak için kullanılan temsili fotoğraflardır. Salondaki uygulamaları Instagram hesabımızda görebilirsiniz.") <a href="@Model.Setting("Social_Instagram")" target="_blank" rel="noopener">Instagram ↗</a></p>
    @if (User.Identity?.IsAuthenticated == true)
    {
        ViewData["EditUrl"] = "/Admin/Services";
        <partial name="_EditButton" />
    }
</section>

@if (otherServices.Any())
{
<section class="other-services">
    <div class="atelier-container">
        <div class="section-heading"><div><p class="eyebrow">@(en ? "Also at the salon / 02" : "Salonda ayrıca / 02")</p><h2>@(en ? "More ways to care." : "Küçük dokunuşlar.")</h2></div><div class="section-aside"><p>@(en ? "Styling, maintenance and everyday appointments. Open a category to see the services." : "Şekillendirme, bakım ve günlük randevular. İşlemleri görmek için ilgili başlığı açın.")</p></div></div>
        @foreach (var (category, subtitleKey, titleKey) in Model.CategoryOrder)
        {
            var group = otherServices.Where(s => s.Category == category).ToList();
            if (!group.Any()) { continue; }
            <details class="service-information">
                <summary>@Model.GetContent(titleKey, category) <span aria-hidden="true">+</span></summary>
                <div class="additional-service-list">
                    @foreach (var service in group)
                    {
                        <div><h3>@service.LocalizedName(culture)</h3><p>@service.LocalizedDescription(culture)</p><a class="editorial-link" href="@(SitePaths.Appointment(culture) + "?serviceId=" + service.Id)">@(en ? "Arrange a visit" : "Randevu için sor") <span aria-hidden="true">↗</span></a></div>
                    }
                </div>
            </details>
        }
    </div>
</section>
}

<section class="atelier-invitation">
    <div class="atelier-container">
        <p class="eyebrow">@(en ? "Let's choose together" : "Birlikte seçelim")</p>
        <h2>@(en ? "Not sure where to start?" : "Nereden başlayacağınızı bilmiyor musunuz?")</h2>
        <a href="@SitePaths.Appointment(culture)" class="atelier-button">@(en ? "Talk to the salon" : "Salona danışın") <span aria-hidden="true">↗</span></a>
    </div>
</section>
