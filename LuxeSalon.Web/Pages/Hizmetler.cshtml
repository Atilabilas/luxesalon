@page
@model LuxeSalon.Web.Pages.HizmetlerModel
@{
    ViewData["Title"] = "Hizmetlerimiz — Celil Kuaför";
}

@* Hero Banner *@
<section class="relative h-[60vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?q=80&w=1920&auto=format&fit=crop" 
             alt="Hizmetlerimiz" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-luxe-charcoal/70"></div>
    </div>
    <div class="relative z-10 text-center text-white px-6">
        <p class="section-subtitle text-luxe-gold mb-4">Uzman Eller, Kusursuz Sonuçlar</p>
        <h1 class="section-title text-white">Hizmetlerimiz</h1>
        <p class="mt-6 text-white/70 max-w-2xl mx-auto font-light text-lg">
            Her saç tipi ve her ihtiyaç için özel olarak tasarlanmış premium hizmetlerimizle tanışın.
        </p>
    </div>
</section>

@* Services Grid *@
<section class="section-padding bg-luxe-ivory">
    <div class="container mx-auto">
        @if (!Model.Services.Any())
        {
            <div class="text-center py-20">
                <p class="text-4xl font-serif italic text-luxe-charcoal/30 mb-8">Hizmetlerimiz hazırlanıyor...</p>
                <p class="text-lg text-luxe-charcoal/50">Çok yakında detaylı hizmet listemizle burada olacağız.</p>
            </div>
        }
        else
        {
            @* Category: Kesim *@
            @if (Model.Services.Any(s => s.Category == "Kesim"))
            {
                <div class="mb-20 reveal">
                    <div class="text-center mb-12">
                        <p class="section-subtitle">Precision Cut</p>
                        <h2 class="section-title">Saç Kesimi</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        @foreach (var service in Model.Services.Where(s => s.Category == "Kesim"))
                        {
                            <div class="group bg-white p-8 shadow-sm hover:shadow-xl transition-all duration-500">
                                @if (!string.IsNullOrEmpty(service.ImageUrl))
                                {
                                    <div class="aspect-video mb-6 overflow-hidden">
                                        <img src="@service.ImageUrl" alt="@service.Name" 
                                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                    </div>
                                }
                                <h3 class="text-2xl font-serif mb-3 group-hover:text-luxe-gold transition-colors">@service.Name</h3>
                                <p class="text-luxe-charcoal/60 font-light mb-4">@service.Description</p>
                                <div class="flex items-center justify-between pt-4 border-t border-luxe-charcoal/10">
                                    <span class="text-2xl font-serif text-luxe-gold">@service.Price.ToString("C0")</span>
                                    <span class="text-sm text-luxe-charcoal/40">@service.DurationMinutes dk</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Category: Renk *@
            @if (Model.Services.Any(s => s.Category == "Renk"))
            {
                <div class="mb-20 reveal">
                    <div class="text-center mb-12">
                        <p class="section-subtitle">Artisan Color</p>
                        <h2 class="section-title">Renklendirme</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        @foreach (var service in Model.Services.Where(s => s.Category == "Renk"))
                        {
                            <div class="group bg-white p-8 shadow-sm hover:shadow-xl transition-all duration-500">
                                @if (!string.IsNullOrEmpty(service.ImageUrl))
                                {
                                    <div class="aspect-video mb-6 overflow-hidden">
                                        <img src="@service.ImageUrl" alt="@service.Name" 
                                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                    </div>
                                }
                                <h3 class="text-2xl font-serif mb-3 group-hover:text-luxe-gold transition-colors">@service.Name</h3>
                                <p class="text-luxe-charcoal/60 font-light mb-4">@service.Description</p>
                                <div class="flex items-center justify-between pt-4 border-t border-luxe-charcoal/10">
                                    <span class="text-2xl font-serif text-luxe-gold">@service.Price.ToString("C0")</span>
                                    <span class="text-sm text-luxe-charcoal/40">@service.DurationMinutes dk</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Category: Bakım *@
            @if (Model.Services.Any(s => s.Category == "Bakım"))
            {
                <div class="mb-20 reveal">
                    <div class="text-center mb-12">
                        <p class="section-subtitle">Hair Rituals</p>
                        <h2 class="section-title">Bakım & Onarım</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        @foreach (var service in Model.Services.Where(s => s.Category == "Bakım"))
                        {
                            <div class="group bg-white p-8 shadow-sm hover:shadow-xl transition-all duration-500">
                                @if (!string.IsNullOrEmpty(service.ImageUrl))
                                {
                                    <div class="aspect-video mb-6 overflow-hidden">
                                        <img src="@service.ImageUrl" alt="@service.Name" 
                                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                    </div>
                                }
                                <h3 class="text-2xl font-serif mb-3 group-hover:text-luxe-gold transition-colors">@service.Name</h3>
                                <p class="text-luxe-charcoal/60 font-light mb-4">@service.Description</p>
                                <div class="flex items-center justify-between pt-4 border-t border-luxe-charcoal/10">
                                    <span class="text-2xl font-serif text-luxe-gold">@service.Price.ToString("C0")</span>
                                    <span class="text-sm text-luxe-charcoal/40">@service.DurationMinutes dk</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Other Categories *@
            var otherServices = Model.Services.Where(s => s.Category != "Kesim" && s.Category != "Renk" && s.Category != "Bakım");
            if (otherServices.Any())
            {
                <div class="mb-20 reveal">
                    <div class="text-center mb-12">
                        <p class="section-subtitle">Special Services</p>
                        <h2 class="section-title">Özel Hizmetler</h2>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                        @foreach (var service in otherServices)
                        {
                            <div class="group bg-white p-8 shadow-sm hover:shadow-xl transition-all duration-500">
                                @if (!string.IsNullOrEmpty(service.ImageUrl))
                                {
                                    <div class="aspect-video mb-6 overflow-hidden">
                                        <img src="@service.ImageUrl" alt="@service.Name" 
                                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                    </div>
                                }
                                <h3 class="text-2xl font-serif mb-3 group-hover:text-luxe-gold transition-colors">@service.Name</h3>
                                <p class="text-luxe-charcoal/60 font-light mb-4">@service.Description</p>
                                <div class="flex items-center justify-between pt-4 border-t border-luxe-charcoal/10">
                                    <span class="text-2xl font-serif text-luxe-gold">@service.Price.ToString("C0")</span>
                                    <span class="text-sm text-luxe-charcoal/40">@service.DurationMinutes dk</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</section>

@* CTA Section *@
<section class="bg-luxe-charcoal text-white py-32">
    <div class="container mx-auto px-6 text-center">
        <p class="section-subtitle text-luxe-gold">Randevu</p>
        <h2 class="section-title text-white mb-6">Hizmetlerimizi Deneyimleyin</h2>
        <p class="text-white/60 max-w-2xl mx-auto mb-12 font-light text-lg">
            Uzman stilistlerimizle tanışın ve hayalinizdeki saça kavuşun.
        </p>
        <a href="/Randevu" class="btn-primary inline-block">
            RANDEVU AL
        </a>
    </div>
</section>

@* Price Note *@
<section class="bg-luxe-cream py-16">
    <div class="container mx-auto px-6 text-center">
        <p class="text-luxe-charcoal/60 font-light">
            <span class="text-luxe-gold">*</span> Fiyatlar saç uzunluğu ve işlem karmaşıklığına göre değişiklik gösterebilir. 
            Detaylı bilgi için lütfen bizimle iletişime geçin.
        </p>
    </div>
</section>

@section Scripts {
    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
}
