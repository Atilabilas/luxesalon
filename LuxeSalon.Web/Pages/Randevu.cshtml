@page "/randevu"
@model LuxeSalon.Web.Pages.RandevuModel
@{
    ViewData["Title"] = Model.GetContent("randevu_page_title");
}

@* Hero Banner *@
<section class="relative h-[50vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        @if (Model.HeroImage != null)
        {
            <img src="@Model.HeroImage.ImageUrl"
                 alt="@(Model.HeroImage.AltText ?? Model.HeroImage.Title ?? Model.GetContent("randevu_hero_title"))"
                 class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
        }
        <div class="absolute inset-0 bg-luxe-charcoal/60"></div>
    </div>
    <div class="relative z-10 text-center text-white">
        <p class="section-subtitle text-luxe-gold mb-4">@Model.GetContent("randevu_hero_subtitle")</p>
        <h1 class="section-title text-white">@Model.GetContent("randevu_hero_title")</h1>
    </div>
</section>

<section class="section-padding bg-luxe-ivory">
    <div class="container mx-auto max-w-5xl">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

            @* Sol: Bilgi *@
            <div class="reveal-left">
                <p class="section-subtitle">@Model.GetContent("randevu_intro_title")</p>
                <h2 class="text-4xl md:text-5xl font-serif mb-8 leading-tight">
                    @Html.Raw(Model.GetContent("randevu_intro_heading"))
                </h2>
                <p class="text-lg font-light text-luxe-charcoal/70 leading-relaxed mb-12">
                    @Model.GetContent("randevu_intro_desc")
                </p>

                <div class="space-y-6 mb-12">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 bg-luxe-gold/10 flex items-center justify-center flex-shrink-0">
                            <span class="text-luxe-gold text-xl">📍</span>
                        </div>
                        <div>
                            <h4 class="font-serif text-lg mb-1">@Model.GetContent("randevu_label_address")</h4>
                            <p class="text-luxe-charcoal/60 font-light">@Html.Raw(Model.FullAddress())</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 bg-luxe-gold/10 flex items-center justify-center flex-shrink-0">
                            <span class="text-luxe-gold text-xl">📞</span>
                        </div>
                        <div>
                            <h4 class="font-serif text-lg mb-1">@Model.GetContent("randevu_label_phone")</h4>
                            <p class="text-luxe-charcoal/60 font-light">@Model.Setting("Contact_Phone")</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 bg-luxe-gold/10 flex items-center justify-center flex-shrink-0">
                            <span class="text-luxe-gold text-xl">🕐</span>
                        </div>
                        <div>
                            <h4 class="font-serif text-lg mb-1">@Model.GetContent("randevu_label_hours")</h4>
                            <p class="text-luxe-charcoal/60 font-light">@Html.Raw(Model.ContactHours())</p>
                        </div>
                    </div>
                </div>
            </div>

            @* Sağ: Form *@
            <div class="reveal-right">
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="bg-green-50 border-l-4 border-green-500 p-6 mb-8">
                        <div class="flex items-center gap-4">
                            <span class="text-3xl">✅</span>
                            <div>
                                <h4 class="font-serif text-lg text-green-800">@Model.GetContent("randevu_success_title")</h4>
                                <p class="text-green-700">@Model.SuccessMessage</p>
                            </div>
                        </div>
                    </div>
                }
                <form method="post" class="bg-white p-8 md:p-12 shadow-lg">
                    <h3 class="text-2xl font-serif mb-8">@Model.GetContent("randevu_form_title")</h3>

                    <div class="space-y-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="FirstName" class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">@Model.GetContent("randevu_label_firstname")</label>
                                <input type="text" name="FirstName" id="FirstName" autocomplete="given-name" required
                                       class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent"
                                       placeholder="@Model.GetContent("randevu_placeholder_firstname")" />
                            </div>
                            <div>
                                <label for="LastName" class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">@Model.GetContent("randevu_label_lastname")</label>
                                <input type="text" name="LastName" id="LastName" autocomplete="family-name" required
                                       class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent"
                                       placeholder="@Model.GetContent("randevu_placeholder_lastname")" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="Phone" class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">@Model.GetContent("randevu_label_phone")</label>
                                <input type="tel" name="Phone" id="Phone" autocomplete="tel" required
                                       class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent"
                                       placeholder="@Model.GetContent("randevu_placeholder_phone")" />
                            </div>
                            <div>
                                <label for="Email" class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">@Model.GetContent("randevu_label_email")</label>
                                <input type="email" name="Email" id="Email" autocomplete="email"
                                       class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent"
                                       placeholder="@Model.GetContent("randevu_placeholder_email")" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label for="Date" class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">@Model.GetContent("randevu_label_date")</label>
                                <input type="date" name="Date" id="Date" required min="@DateTime.Now.ToString("yyyy-MM-dd")"
                                       class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent" />
                            </div>
                            <div>
                                <label for="Time" class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">@Model.GetContent("randevu_label_time")</label>
                                <select name="Time" id="Time" required
                                        class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent">
                                    <option value="">@Model.GetContent("randevu_time_select")</option>
                                    @for (int i = 9; i < 20; i++)
                                    {
                                        <option value="@($"{i:00}:00")">@($"{i:00}:00")</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div>
                            <label for="ServiceId" class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">@Model.GetContent("randevu_label_service")</label>
                            <select name="ServiceId" id="ServiceId" required
                                    class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent">
                                <option value="">@Model.GetContent("randevu_service_select")</option>
                                @foreach (var service in Model.Services)
                                {
                                    <option value="@service.Id" selected="@(Model.SelectedServiceId == service.Id)">@service.LocalizedName(Model.CurrentCulture)</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label for="Notes" class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">@Model.GetContent("randevu_label_notes")</label>
                            <textarea name="Notes" id="Notes" rows="3"
                                      class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent resize-none"
                                      placeholder="@Model.GetContent("randevu_placeholder_notes")"></textarea>
                        </div>

                        <button type="submit" class="btn-primary w-full mt-4">
                            @Model.GetContent("randevu_submit")
                        </button>

                        <p class="text-xs text-luxe-charcoal/40 text-center mt-4">
                            @Model.GetContent("randevu_sms_note")
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
    </script>
}
