@page
@model LuxeSalon.Web.Pages.RandevuModel
@{
    ViewData["Title"] = "Randevu Al — Celil Kuaför";
}

@* Hero Banner *@
<section class="relative h-[50vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?q=80&w=1920&auto=format&fit=crop" 
             alt="Randevu" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-luxe-charcoal/60"></div>
    </div>
    <div class="relative z-10 text-center text-white">
        <p class="section-subtitle text-luxe-gold mb-4">Online Rezervasyon</p>
        <h1 class="section-title text-white">Randevu Al</h1>
    </div>
</section>

<section class="section-padding bg-luxe-ivory">
    <div class="container mx-auto max-w-5xl">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
            
            @* Sol: Bilgi *@
            <div class="reveal-left">
                <p class="section-subtitle">Bize Ulaşın</p>
                <h2 class="text-4xl md:text-5xl font-serif mb-8 leading-tight">
                    Güzellik<br/><span class="italic">Yolculuğunuz</span><br/>Başlasın
                </h2>
                <p class="text-lg font-light text-luxe-charcoal/70 leading-relaxed mb-12">
                    Celil Kuaför olarak, her randevunuzda size özel bir deneyim sunuyoruz. 
                    Uzman ekibimiz, en son trendleri ve teknikleri kullanarak hayalinizdeki 
                    görünümü yaratmak için sizinle birlikte çalışıyor.
                </p>

                <div class="space-y-6 mb-12">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 bg-luxe-gold/10 flex items-center justify-center flex-shrink-0">
                            <span class="text-luxe-gold text-xl">📍</span>
                        </div>
                        <div>
                            <h4 class="font-serif text-lg mb-1">Adres</h4>
                            <p class="text-luxe-charcoal/60 font-light">Alsancak Mah. Kıbrıs Şehitleri Cad. No: 45<br/>Konak, İzmir</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 bg-luxe-gold/10 flex items-center justify-center flex-shrink-0">
                            <span class="text-luxe-gold text-xl">📞</span>
                        </div>
                        <div>
                            <h4 class="font-serif text-lg mb-1">Telefon</h4>
                            <p class="text-luxe-charcoal/60 font-light">+90 232 XXX XX XX</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 bg-luxe-gold/10 flex items-center justify-center flex-shrink-0">
                            <span class="text-luxe-gold text-xl">🕐</span>
                        </div>
                        <div>
                            <h4 class="font-serif text-lg mb-1">Çalışma Saatleri</h4>
                            <p class="text-luxe-charcoal/60 font-light">Pazartesi - Cumartesi: 09:00 - 20:00<br/>Pazar: Kapalı</p>
                        </div>
                    </div>
                </div>
            </div>

            @* Sağ: Form *@
            <div class="reveal-right">
                @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                {
                    <div class="bg-green-50 border-l-4 border-green-500 p-6 mb-8">
                        <div class="flex items-center gap-4">
                            <span class="text-3xl">✅</span>
                            <div>
                                <h4 class="font-serif text-lg text-green-800">Randevunuz Alındı!</h4>
                                <p class="text-green-700">@Model.SuccessMessage</p>
                            </div>
                        </div>
                    </div>
                }
                <form method="post" class="bg-white p-8 md:p-12 shadow-lg">
                    <h3 class="text-2xl font-serif mb-8">Randevu Bilgileri</h3>
                    
                    <div class="space-y-6">
                        @* Ad Soyad *@
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Ad *</label>
                                <input type="text" name="FirstName" required
                                       class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent"
                                       placeholder="Adınız" />
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Soyad *</label>
                                <input type="text" name="LastName" required
                                       class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent"
                                       placeholder="Soyadınız" />
                            </div>
                        </div>

                        @* Telefon & Email *@
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Telefon *</label>
                                <input type="tel" name="Phone" required
                                       class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent"
                                       placeholder="0 5XX XXX XX XX" />
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">E-posta</label>
                                <input type="email" name="Email"
                                       class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent"
                                       placeholder="ornek@email.com" />
                            </div>
                        </div>

                        @* Tarih & Saat *@
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Tarih *</label>
                                <input type="date" name="Date" required
                                       class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent" />
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Saat *</label>
                                <select name="Time" required
                                        class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent">
                                    <option value="">Saat Seçin</option>
                                    <option value="09:00">09:00</option>
                                    <option value="10:00">10:00</option>
                                    <option value="11:00">11:00</option>
                                    <option value="12:00">12:00</option>
                                    <option value="13:00">13:00</option>
                                    <option value="14:00">14:00</option>
                                    <option value="15:00">15:00</option>
                                    <option value="16:00">16:00</option>
                                    <option value="17:00">17:00</option>
                                    <option value="18:00">18:00</option>
                                    <option value="19:00">19:00</option>
                                </select>
                            </div>
                        </div>

                        @* Hizmet *@
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Hizmet *</label>
                            <select name="Service" required
                                    class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent">
                                <option value="">Hizmet Seçin</option>
                                <option value="Saç Kesimi">Saç Kesimi</option>
                                <option value="Saç Boyama">Saç Boyama</option>
                                <option value="Ombre / Sombre">Ombre / Sombre</option>
                                <option value="Balyaj / Highlights">Balyaj / Highlights</option>
                                <option value="Keratin Bakım">Keratin Bakım</option>
                                <option value="Fön & Şekillendirme">Fön & Şekillendirme</option>
                                <option value="Gelin Saçı">Gelin Saçı</option>
                                <option value="Makyaj">Makyaj</option>
                                <option value="Komple Bakım">Komple Bakım</option>
                            </select>
                        </div>

                        @* Not *@
                        <div>
                            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Notunuz</label>
                            <textarea name="Notes" rows="3"
                                      class="w-full border-b-2 border-luxe-charcoal/20 px-0 py-3 focus:border-luxe-gold focus:outline-none transition-colors bg-transparent resize-none"
                                      placeholder="Eklemek istediğiniz bir not varsa yazabilirsiniz..."></textarea>
                        </div>

                        @* Submit *@
                        <button type="submit" class="btn-primary w-full mt-4">
                            RANDEVU OLUŞTUR
                        </button>

                        <p class="text-xs text-luxe-charcoal/40 text-center mt-4">
                            Randevunuz onaylandığında size SMS ile bilgi verilecektir.
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
    </script>
}
