@page "/gizlilik"
@model LuxeSalon.Web.Pages.PrivacyModel
@{
    ViewData["Title"] = Model.GetContent("privacy_title");
}

<section class="section-padding bg-luxe-ivory pt-40">
    <div class="container mx-auto px-6 max-w-4xl">
        <h1 class="text-4xl md:text-5xl font-serif mb-12">@Model.GetContent("privacy_title")</h1>
        <div class="prose prose-lg max-w-none font-light text-luxe-charcoal/80 leading-relaxed">
            @Html.Raw(Model.GetContent("privacy_content"))
        </div>
    </div>
</section>
