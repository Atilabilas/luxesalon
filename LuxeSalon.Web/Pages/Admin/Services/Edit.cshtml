@page "{id:int}"
@model LuxeSalon.Web.Pages.Admin.Services.EditModel
@{
    ViewData["Title"] = "Hizmet Düzenle — Admin";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="max-w-2xl">
    <div class="mb-8">
        <a asp-page="Index" class="text-luxe-gold hover:underline text-sm mb-4 inline-block">← Geri</a>
        <h1 class="text-3xl font-serif font-semibold text-luxe-charcoal">Hizmet Düzenle</h1>
    </div>

    <form method="post" enctype="multipart/form-data" class="bg-white p-8 shadow-sm space-y-6">
        <input type="hidden" asp-for="Service.Id" />

        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Hizmet Adı *</label>
            <input type="text" asp-for="Service.Name" required class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Açıklama</label>
            <textarea asp-for="Service.Description" rows="4" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none resize-none"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Fiyat (₺) *</label>
                <input type="number" asp-for="Service.Price" required step="0.01" min="0" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
            </div>
            <div>
                <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Süre (dk)</label>
                <input type="number" asp-for="Service.DurationMinutes" min="1" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
            </div>
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Kategori</label>
            <input type="text" asp-for="Service.Category" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        @if (!string.IsNullOrEmpty(Model.Service.ImageUrl))
        {
            <div>
                <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Mevcut Görsel</label>
                <img src="@Model.Service.ImageUrl" alt="@Model.Service.Name" class="max-w-xs h-40 object-cover border border-luxe-charcoal/10" />
            </div>
        }
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Yeni Görsel Yükle</label>
            <input type="file" name="ImageFile" accept="image/*" class="w-full border border-luxe-charcoal/20 px-4 py-3" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Görsel URL</label>
            <input type="text" asp-for="Service.ImageUrl" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        <div class="flex gap-4 pt-4">
            <button type="submit" class="bg-luxe-gold text-white px-8 py-3 font-medium hover:bg-luxe-gold/90 transition-colors">GÜNCELLE</button>
            <a asp-page="Index" class="border border-luxe-charcoal/20 px-8 py-3 font-medium hover:bg-luxe-charcoal/5 transition-colors">İPTAL</a>
        </div>
    </form>
</div>
