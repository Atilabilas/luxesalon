@page
@model LuxeSalon.Web.Pages.Admin.Testimonials.CreateModel
@{
    ViewData["Title"] = "Yeni Yorum — Admin";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="max-w-2xl">
    <div class="mb-8">
        <a asp-page="Index" class="text-luxe-gold hover:underline text-sm mb-4 inline-block">← Geri</a>
        <h1 class="text-3xl font-serif font-semibold text-luxe-charcoal">Yeni Yorum</h1>
    </div>
    <form method="post" enctype="multipart/form-data" class="bg-white p-8 shadow-sm space-y-6">
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Yorum *</label>
            <textarea asp-for="Testimonial.Quote" required rows="4" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none resize-none"></textarea>
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Yazar Adı *</label>
            <input type="text" asp-for="Testimonial.AuthorName" required class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Yazar Ünvanı</label>
            <input type="text" asp-for="Testimonial.AuthorTitle" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Görsel Yükle</label>
            <input type="file" name="ImageFile" accept="image/*" class="w-full border border-luxe-charcoal/20 px-4 py-3" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Görsel URL</label>
            <input type="text" asp-for="Testimonial.ImageUrl" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Sıralama</label>
            <input type="number" asp-for="Testimonial.DisplayOrder" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" value="0" />
        </div>
        <div class="flex items-center gap-3">
            <input type="checkbox" asp-for="Testimonial.IsActive" class="w-5 h-5" checked />
            <label asp-for="Testimonial.IsActive" class="text-sm font-medium">Aktif</label>
        </div>
        <div class="flex gap-4 pt-4">
            <button type="submit" class="bg-luxe-gold text-white px-8 py-3 font-medium hover:bg-luxe-gold/90 transition-colors">KAYDET</button>
            <a asp-page="Index" class="border border-luxe-charcoal/20 px-8 py-3 font-medium hover:bg-luxe-charcoal/5 transition-colors">İPTAL</a>
        </div>
    </form>
</div>
