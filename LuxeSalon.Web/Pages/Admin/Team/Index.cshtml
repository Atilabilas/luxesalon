@page
@model LuxeSalon.Web.Pages.Admin.Team.IndexModel
@{
    ViewData["Title"] = "Ekip Yönetimi — Admin";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-3xl font-serif font-semibold text-luxe-charcoal mb-2">Ekip Yönetimi</h1>
        <p class="text-luxe-charcoal/60">Stilistleri ve ekip üyelerini yönetin.</p>
    </div>
    <a asp-page="Create" class="bg-luxe-gold text-white px-6 py-3 font-medium hover:bg-luxe-gold/90 transition-colors">
        + Yeni Ekle
    </a>
</div>

<div class="bg-white shadow-sm overflow-hidden">
    <table class="w-full">
        <thead class="bg-luxe-charcoal/5">
            <tr>
                <th class="text-left px-6 py-4 text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60">Fotoğraf</th>
                <th class="text-left px-6 py-4 text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60">İsim</th>
                <th class="text-left px-6 py-4 text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60">Ünvan</th>
                <th class="text-left px-6 py-4 text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60">Durum</th>
                <th class="text-right px-6 py-4 text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60">İşlemler</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-luxe-charcoal/10">
            @foreach (var member in Model.TeamMembers)
            {
                <tr class="hover:bg-luxe-charcoal/5 transition-colors">
                    <td class="px-6 py-4">
                        <img src="@(string.IsNullOrEmpty(member.ImageUrl) ? "/images/placeholder.jpg" : member.ImageUrl)" 
                             alt="@member.Name" class="w-16 h-16 object-cover rounded-full" />
                    </td>
                    <td class="px-6 py-4 font-serif font-medium">@member.Name</td>
                    <td class="px-6 py-4 text-luxe-charcoal/60">@member.Role</td>
                    <td class="px-6 py-4">
                        @if (member.IsActive)
                        {
                            <span class="bg-green-100 text-green-800 px-3 py-1 text-xs font-medium">Aktif</span>
                        }
                        else
                        {
                            <span class="bg-gray-100 text-gray-600 px-3 py-1 text-xs font-medium">Pasif</span>
                        }
                    </td>
                    <td class="px-6 py-4 text-right">
                        <a asp-page="Edit" asp-route-id="@member.Id" class="text-luxe-gold hover:underline text-sm font-medium mr-4">Düzenle</a>
                        <a asp-page="Delete" asp-route-id="@member.Id" class="text-red-500 hover:underline text-sm font-medium">Sil</a>
                    </td>
                </tr>
            }
            @if (!Model.TeamMembers.Any())
            {
                <tr>
                    <td colspan="5" class="px-6 py-12 text-center text-luxe-charcoal/40">
                        Henüz ekip üyesi eklenmemiş.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
