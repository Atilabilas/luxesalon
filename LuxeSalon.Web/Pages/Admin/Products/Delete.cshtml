@page "{id:int}"
@model LuxeSalon.Web.Pages.Admin.Products.DeleteModel
@{
    ViewData["Title"] = "Ürünü Sil";
}

<div class="min-h-screen bg-luxe-ivory py-12">
    <div class="container mx-auto px-6 max-w-2xl">
        <div class="bg-white p-8 md:p-12 shadow-sm text-center">
            <div class="text-6xl text-red-500 mb-6">⚠️</div>
            <h1 class="text-3xl font-serif mb-4">Silmek İstediğinize Emin Misiniz?</h1>
            <p class="text-luxe-charcoal/60 mb-8">
                "<strong>@Model.Product.Name</strong>" ürünü kalıcı olarak silinecektir.
            </p>
            
            <div class="bg-luxe-cream p-6 mb-8 flex items-center gap-6">
                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                {
                    <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" class="w-20 h-20 object-cover" />
                }
                <div class="text-left">
                    <p class="font-serif text-lg">@Model.Product.Name</p>
                    <p class="text-sm text-luxe-charcoal/60">@Model.Product.Category</p>
                    <p class="text-luxe-gold font-bold">@Model.Product.Price.ToString("C0")</p>
                </div>
            </div>

            <form method="post" class="flex gap-4 justify-center">
                <button type="submit" class="bg-red-600 text-white px-8 py-4 text-[11px] uppercase font-bold tracking-widest hover:bg-red-700 transition-colors">
                    EVET, SİL
                </button>
                <a href="/Admin/Products" class="btn-outline">
                    İPTAL
                </a>
            </form>
        </div>
    </div>
</div>
