@page "{id:int}"
@model LuxeSalon.Web.Pages.Admin.Awards.EditModel
@{
    ViewData["Title"] = "Ödül Düzenle — Admin";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="max-w-2xl">
    <div class="mb-8">
        <a asp-page="Index" class="text-luxe-gold hover:underline text-sm mb-4 inline-block">← Geri</a>
        <h1 class="text-3xl font-serif font-semibold text-luxe-charcoal">Ödül Düzenle</h1>
    </div>
    <form method="post" class="bg-white p-8 shadow-sm space-y-6">
        <input type="hidden" asp-for="AwardItem.Id" />
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">İkon</label>
            <input type="text" asp-for="AwardItem.Icon" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
            @if (!string.IsNullOrEmpty(Model.AwardItem.Icon))
            {
                <p class="mt-2 text-3xl">@Model.AwardItem.Icon</p>
            }
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Başlık *</label>
            <input type="text" asp-for="AwardItem.Title" required class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Alt Başlık</label>
            <input type="text" asp-for="AwardItem.Subtitle" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Yıl</label>
            <input type="text" asp-for="AwardItem.Year" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Sıralama</label>
            <input type="number" asp-for="AwardItem.DisplayOrder" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        <div class="flex items-center gap-3">
            <input type="checkbox" asp-for="AwardItem.IsActive" class="w-5 h-5" />
            <label asp-for="AwardItem.IsActive" class="text-sm font-medium">Aktif</label>
        </div>
        <div class="flex gap-4 pt-4">
            <button type="submit" class="bg-luxe-gold text-white px-8 py-3 font-medium hover:bg-luxe-gold/90 transition-colors">GÜNCELLE</button>
            <a asp-page="Index" class="border border-luxe-charcoal/20 px-8 py-3 font-medium hover:bg-luxe-charcoal/5 transition-colors">İPTAL</a>
        </div>
    </form>
</div>
