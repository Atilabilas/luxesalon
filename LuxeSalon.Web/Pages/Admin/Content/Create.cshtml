@page
@model LuxeSalon.Web.Pages.Admin.Content.CreateModel
@{
    ViewData["Title"] = "Yeni İçerik — Admin";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="max-w-2xl">
    <div class="mb-8">
        <a asp-page="Index" class="text-luxe-gold hover:underline text-sm mb-4 inline-block">← Geri</a>
        <h1 class="text-3xl font-serif font-semibold text-luxe-charcoal">Yeni İçerik</h1>
    </div>

    <form method="post" class="bg-white p-8 shadow-sm space-y-6">
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Anahtar (Key) *</label>
            <input type="text" asp-for="SiteContent.Key" required class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none font-mono" placeholder="hero_title" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Bölüm (Section) *</label>
            <input type="text" asp-for="SiteContent.Section" required class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" placeholder="Hero" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Etiket</label>
            <input type="text" asp-for="SiteContent.Label" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">İçerik Tipi</label>
            <select asp-for="SiteContent.ContentType" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none bg-white">
                <option value="text">Metin</option>
                <option value="html">HTML</option>
                <option value="image_url">Görsel URL</option>
            </select>
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">İçerik *</label>
            <textarea asp-for="SiteContent.Value" required rows="6" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none resize-none"></textarea>
        </div>
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Sıralama</label>
            <input type="number" asp-for="SiteContent.DisplayOrder" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" value="0" />
        </div>
        <div class="flex gap-4 pt-4">
            <button type="submit" class="bg-luxe-gold text-white px-8 py-3 font-medium hover:bg-luxe-gold/90 transition-colors">KAYDET</button>
            <a asp-page="Index" class="border border-luxe-charcoal/20 px-8 py-3 font-medium hover:bg-luxe-charcoal/5 transition-colors">İPTAL</a>
        </div>
    </form>
</div>
