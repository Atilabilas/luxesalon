@page "{id:int}"
@model LuxeSalon.Web.Pages.Admin.Content.EditModel
@{
    ViewData["Title"] = "İçerik Düzenle — Admin";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="max-w-2xl">
    <div class="mb-8">
        <a asp-page="Index" class="text-luxe-gold hover:underline text-sm mb-4 inline-block">← Geri</a>
        <h1 class="text-3xl font-serif font-semibold text-luxe-charcoal">İçerik Düzenle</h1>
        <p class="text-luxe-charcoal/60 mt-2">
            <span class="text-xs bg-luxe-gold/10 px-2 py-1 font-mono text-luxe-gold">@Model.SiteContent.Key</span>
            <span class="mx-2">•</span>
            <span class="text-sm">@Model.SiteContent.Section</span>
        </p>
    </div>

    <form method="post" class="bg-white p-8 shadow-sm space-y-6">
        <input type="hidden" asp-for="SiteContent.Id" />
        <input type="hidden" asp-for="SiteContent.Key" />
        <input type="hidden" asp-for="SiteContent.Section" />
        <input type="hidden" asp-for="SiteContent.ContentType" />
        <input type="hidden" asp-for="SiteContent.DisplayOrder" />
        
        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">Etiket (Admin)</label>
            <input asp-for="SiteContent.Label" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none" />
        </div>

        <div>
            <label class="block text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60 mb-2">İçerik</label>
            @if (Model.SiteContent.ContentType == "html")
            {
                <textarea asp-for="SiteContent.Value" rows="10" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none font-mono text-sm"></textarea>
            }
            else
            {
                <textarea asp-for="SiteContent.Value" rows="4" class="w-full border border-luxe-charcoal/20 px-4 py-3 focus:border-luxe-gold focus:outline-none"></textarea>
            }
        </div>

        <div class="flex gap-4 pt-4">
            <button type="submit" class="bg-luxe-gold text-white px-8 py-3 font-medium hover:bg-luxe-gold/90 transition-colors">
                KAYDET
            </button>
            <a asp-page="Index" class="border border-luxe-charcoal/20 px-8 py-3 font-medium hover:bg-luxe-charcoal/5 transition-colors">
                İPTAL
            </a>
        </div>
    </form>
</div>
