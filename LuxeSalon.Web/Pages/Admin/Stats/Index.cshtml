@page
@model LuxeSalon.Web.Pages.Admin.Stats.IndexModel
@{
    ViewData["Title"] = "İstatistikler — Admin";
    Layout = "~/Pages/Shared/_AdminLayout.cshtml";
}

<div class="mb-8 flex items-center justify-between">
    <div>
        <h1 class="text-3xl font-serif font-semibold text-luxe-charcoal mb-2">İstatistikler</h1>
        <p class="text-luxe-charcoal/60">@Model.Items.Count öğe</p>
    </div>
    <a asp-page="Create" class="bg-luxe-gold text-white px-6 py-3 font-medium hover:bg-luxe-gold/90 transition-colors">+ Yeni İstatistik</a>
</div>

<div class="bg-white shadow-sm overflow-hidden">
    <table class="w-full">
        <thead class="bg-luxe-charcoal/5">
            <tr>
                <th class="text-left px-6 py-4 text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60">Değer</th>
                <th class="text-left px-6 py-4 text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60">Etiket</th>
                <th class="text-left px-6 py-4 text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60">Bölüm</th>
                <th class="text-right px-6 py-4 text-[10px] uppercase tracking-widest font-bold text-luxe-charcoal/60">İşlemler</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-luxe-charcoal/10">
            @foreach (var item in Model.Items)
            {
                <tr class="hover:bg-luxe-charcoal/5 transition-colors">
                    <td class="px-6 py-4 text-2xl font-serif text-luxe-gold">@item.Value</td>
                    <td class="px-6 py-4">@item.Label</td>
                    <td class="px-6 py-4 text-luxe-charcoal/60 text-sm">@item.Section</td>
                    <td class="px-6 py-4 text-right">
                        <a asp-page="Edit" asp-route-id="@item.Id" class="text-luxe-gold hover:underline text-sm font-medium mr-4">Düzenle</a>
                        <a asp-page="Delete" asp-route-id="@item.Id" class="text-red-500 hover:underline text-sm font-medium">Sil</a>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr><td colspan="4" class="px-6 py-12 text-center text-luxe-charcoal/40">Henüz istatistik yok.</td></tr>
            }
        </tbody>
    </table>
</div>
