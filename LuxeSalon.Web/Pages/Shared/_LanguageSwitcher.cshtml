@using LuxeSalon.Web.Services
@{
    var culture = SitePaths.DetectCulture(Context.Request.Path);
    var stripped = SitePaths.StripCulturePrefix(Context.Request.Path.Value ?? "/");
    string SwitchTo(string target)
    {
        var alternate = ViewData[target == "en" ? "HreflangEn" : "HreflangTr"] as string;
        if (!string.IsNullOrWhiteSpace(alternate) && Uri.TryCreate(alternate, UriKind.Absolute, out var uri)) return uri.AbsolutePath;
        if (stripped.StartsWith("/blog/")) return SitePaths.Blog(target);
        if (stripped.StartsWith("/hizmetler/") || stripped.StartsWith("/services/")) return SitePaths.Services(target);
        return stripped switch
        {
            "/hakkimizda" or "/about" => SitePaths.About(target),
            "/hizmetler" or "/services" => SitePaths.Services(target),
            "/blog" => SitePaths.Blog(target),
            "/randevu" or "/appointment" => SitePaths.Appointment(target),
            "/gizlilik" or "/privacy" => SitePaths.Privacy(target),
            "/izmir-ilceleri" or "/izmir-districts" => SitePaths.Districts(target),
            "/magaza" or "/shop" => SitePaths.Shop(target),
            _ => SitePaths.Home(target)
        };
    }
}
<nav class="language-pair" aria-label="@(culture == "en" ? "Language" : "Dil seçimi")">
    <a href="@SwitchTo("tr")" lang="tr" hreflang="tr" aria-label="Türkçe" aria-current="@(culture == "tr" ? "true" : null)">TR</a>
    <span aria-hidden="true">/</span>
    <a href="@SwitchTo("en")" lang="en" hreflang="en" aria-label="English" aria-current="@(culture == "en" ? "true" : null)">EN</a>
</nav>
