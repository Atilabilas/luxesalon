@using Microsoft.EntityFrameworkCore
@using LuxeSalon.Infrastructure.Data
@using LuxeSalon.Web.Services
@inject ApplicationDbContext DbContext
@inject SiteSettingsService SettingsService
@{
    var culture = SitePaths.DetectCulture(Context.Request.Path);
    var en = culture == "en";
    var settings = await SettingsService.GetSettingsAsync();
    var siteName = settings.GetValueOrDefault("Site_Name", "Celil & Atilla");
    var siteUrl = settings.GetValueOrDefault("Site_Url", "https://celilatilla.com").TrimEnd('/');
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? settings.GetValueOrDefault("Site_Title", siteName)
        : pageTitle.Contains(siteName, StringComparison.OrdinalIgnoreCase) || pageTitle.Contains('|')
            ? pageTitle : $"{pageTitle} | {siteName}";
    var metaDescription = ViewData["MetaDescription"] as string ?? settings.GetValueOrDefault("SEO_Description", "");
    var canonical = ViewData["Canonical"] as string ?? siteUrl + Context.Request.Path;
    var pagePath = new Uri(canonical).AbsolutePath;
    var home = SitePaths.Home(culture);
    var isHome = pagePath == home;
    var about = SitePaths.About(culture);
    var services = SitePaths.Services(culture);
    var blog = SitePaths.Blog(culture);
    var appointment = SitePaths.Appointment(culture);
    var privacy = SitePaths.Privacy(culture);
    var footerRows = await DbContext.SiteContents.AsNoTracking().Where(c => c.Key == "footer_desc").ToListAsync();
    var footerDesc = footerRows.FirstOrDefault(c => c.Culture == culture)?.Value ?? footerRows.FirstOrDefault(c => c.Culture == "tr")?.Value;
    var instagram = settings.GetValueOrDefault("Social_Instagram", "");
    var phone = settings.GetValueOrDefault("Contact_Phone", "0534 794 43 93");
    var phoneDigits = WhatsAppLink.Digits(phone);
    var phoneHref = "tel:" + (phoneDigits.StartsWith("0") ? "+90" + phoneDigits[1..] : phoneDigits.StartsWith("90") ? "+" + phoneDigits : phoneDigits);
    var whatsapp = WhatsAppLink.Chat(settings.GetValueOrDefault("Whatsapp_Number", "905347944393"), settings.GetValueOrDefault("Whatsapp_Message", en ? "Hello" : "Merhaba"));
    var mapUrl = settings.GetValueOrDefault("Map_Google_Url", "");
    var ga4 = settings.GetValueOrDefault("Analytics_GA4_Id", "");
    var ogImage = ViewData["OgImage"] as string ?? settings.GetValueOrDefault("SEO_Default_Og_Image", "/images/services/kadin-kesim.jpg");
    if (!ogImage.StartsWith("http", StringComparison.OrdinalIgnoreCase)) ogImage = siteUrl + ogImage;
    var hreflangTr = ViewData["HreflangTr"] as string;
    var hreflangEn = ViewData["HreflangEn"] as string;
    var isBasicPage = pagePath != "/" && pagePath != "/en" && !pagePath.StartsWith("/blog/") && !pagePath.StartsWith("/en/blog/") && !pagePath.StartsWith("/hizmetler/") && !pagePath.StartsWith("/en/services/");
    var breadcrumbTitle = (pageTitle ?? (en ? "Page" : "Sayfa")).Split('|')[0].Trim();
}
<!DOCTYPE html>
<html lang="@culture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="google-site-verification" content="zPHA1BoEF77AtTsoScqTyoA89V5rJWFm6rCm1m7BRiU" />
    <title>@fullTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="robots" content="@(ViewData["Robots"] as string ?? "index, follow, max-image-preview:large")" />
    <link rel="canonical" href="@canonical" />
    @if (!string.IsNullOrWhiteSpace(hreflangTr)) { <link rel="alternate" hreflang="tr" href="@hreflangTr" /> }
    @if (!string.IsNullOrWhiteSpace(hreflangEn)) { <link rel="alternate" hreflang="en" href="@hreflangEn" /> }
    @if (hreflangTr != null || hreflangEn != null) { <link rel="alternate" hreflang="x-default" href="@(hreflangTr ?? canonical)" /> }
    <link rel="icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="theme-color" content="#FAF9F7" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:locale" content="@(en ? "en_US" : "tr_TR")" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:site_name" content="@siteName" />
    <meta property="og:image" content="@ogImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@fullTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@ogImage" />
    <script type="application/ld+json">@Html.Raw(JsonLdService.HairSalon(settings))</script>
    @if (isBasicPage) { <script type="application/ld+json">@Html.Raw(JsonLdService.Breadcrumb(breadcrumbTitle, pagePath, settings))</script> }
    @if (!string.IsNullOrWhiteSpace(ga4))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@ga4"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ga4)));
        </script>
    }
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/fonts/fonts.css" asp-append-version="true" />
    @if (isHome) { <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" /> }
    <link rel="preload" href="/fonts/atelier-1.woff2" as="font" type="font/woff2" crossorigin />
    @if (pagePath == appointment)
    {
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" media="print" onload="this.media='all'" />
        <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" /></noscript>
    }
    <script defer src="~/js/site.js" asp-append-version="true"></script>
</head>
<body class="bg-luxe-ivory text-luxe-charcoal font-sans antialiased salon-site @(isHome ? "salon-home" : "")">
    <a class="skip-link" href="#main-content">@(en ? "Skip to content" : "İçeriğe geç")</a>
    <header class="site-header" id="main-header">
        <div class="atelier-container header-row">
            <a href="@home" class="site-wordmark" aria-label="@(siteName + (en ? " home" : " ana sayfa"))">@siteName<span>@(en ? "CUT · COLOUR · CARE" : "KESİM · RENK · BAKIM")</span></a>
            <nav class="desktop-nav" aria-label="@(en ? "Main navigation" : "Ana menü")">
                <a href="@home" aria-current="@(isHome ? "page" : null)">@(en ? "Home" : "Ana sayfa")</a>
                <a href="@services" aria-current="@(pagePath.StartsWith(services) ? "page" : null)">@(en ? "Services" : "Hizmetler")</a>
                <a href="@about" aria-current="@(pagePath == about ? "page" : null)">@(en ? "The salon" : "Salon")</a>
                <a href="@blog" aria-current="@(pagePath.StartsWith(blog) ? "page" : null)">@(en ? "Hair journal" : "Saç rehberi")</a>
                <a href="@(home + "#iletisim")">@(en ? "Contact" : "İletişim")</a>
            </nav>
            <div class="header-actions">
                <partial name="_LanguageSwitcher" />
                <a href="@appointment" class="atelier-button header-book">@(en ? "Book a visit" : "Randevu al")</a>
                <details class="mobile-nav" id="mobile-menu">
                    <summary aria-label="@(en ? "Open navigation" : "Menüyü aç")">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
                    </summary>
                    <nav aria-label="@(en ? "Mobile navigation" : "Mobil menü")">
                        <a href="@home">@(en ? "Home" : "Ana sayfa")</a>
                        <a href="@services">@(en ? "Services" : "Hizmetler")</a>
                        <a href="@about">@(en ? "The salon" : "Salon")</a>
                        <a href="@blog">@(en ? "Hair journal" : "Saç rehberi")</a>
                        <a href="@(home + "#iletisim")">@(en ? "Contact" : "İletişim")</a>
                        <a href="@appointment" class="atelier-button">@(en ? "Book a visit" : "Randevu al") ↗</a>
                    </nav>
                </details>
            </div>
        </div>
    </header>
    <main id="main-content">
        @if (isBasicPage)
        {
            <nav class="page-breadcrumb" aria-label="@(en ? "Breadcrumb" : "Sayfa yolu")">
                <a href="@home">@(en ? "Home" : "Ana sayfa")</a><span aria-hidden="true">/</span><span aria-current="page">@breadcrumbTitle</span>
            </nav>
        }
        @RenderBody()
    </main>
    <footer class="site-footer">
        @if (isHome)
        {
            <div class="home-container home-footer">
                <div><a href="@home">@siteName</a><address>@settings.GetValueOrDefault("Contact_Address") · @settings.GetValueOrDefault("Contact_City")</address><a href="@phoneHref">@phone</a></div>
                <nav aria-label="@(en ? "Footer navigation" : "Alt menü")">
                    <a href="@blog">@(en ? "Hair journal" : "Saç rehberi") ↗</a>
                    <a href="@SitePaths.Districts(culture)">@(en ? "İzmir districts" : "İzmir ilçeleri") ↗</a>
                    @if (!string.IsNullOrWhiteSpace(instagram)) { <a href="@instagram" target="_blank" rel="noopener">Instagram ↗</a> }
                    <a href="@privacy">@(en ? "Privacy" : "Gizlilik")</a>
                    <a href="/sitemap.xml">@(en ? "Sitemap" : "Site haritası")</a>
                </nav>
            </div>
        }
        else
        {
        <div class="atelier-container">
            <div class="footer-top">
                <div class="footer-brand"><a href="@home">@siteName</a><p>@footerDesc</p></div>
                <nav aria-label="@(en ? "Footer navigation" : "Alt menü")">
                    <p class="eyebrow">@(en ? "Explore" : "Keşfedin")</p>
                    <a href="@about">@(en ? "The salon & team" : "Salon ve ekip")</a>
                    <a href="@services">@(en ? "All services" : "Tüm hizmetler")</a>
                    <a href="@SitePaths.Districts(culture)">@(en ? "İzmir districts" : "İzmir ilçeleri")</a>
                    <a href="@blog">@(en ? "Hair journal" : "Saç rehberi")</a>
                    <a href="@appointment">@(en ? "Appointments" : "Randevu")</a>
                </nav>
                <div class="footer-contact">
                    <p class="eyebrow">@(en ? "Visit us" : "Bize gelin")</p>
                    <address>@settings.GetValueOrDefault("Contact_Address")<br />@settings.GetValueOrDefault("Contact_City")</address>
                    <a href="@phoneHref">@phone</a>
                    @if (!string.IsNullOrWhiteSpace(mapUrl)) { <a href="@mapUrl" target="_blank" rel="noopener">@(en ? "Get directions" : "Yol tarifi alın") ↗</a> }
                </div>
                <div>
                    <p class="eyebrow">@(en ? "Stay in touch" : "İletişimde kalın")</p>
                    <a href="@whatsapp" target="_blank" rel="noopener">WhatsApp ↗</a>
                    @if (!string.IsNullOrWhiteSpace(instagram)) { <a href="@instagram" target="_blank" rel="noopener">Instagram ↗</a> }
                    <p class="footer-hours">@settings.GetValueOrDefault("Contact_Hours")</p>
                </div>
            </div>
            <div class="footer-bottom"><p>© @DateTime.Now.Year @siteName</p><a href="@privacy">@(en ? "Privacy" : "Gizlilik")</a><a href="/sitemap.xml">@(en ? "Sitemap" : "Site haritası")</a></div>
        </div>
        }
    </footer>
    @if (!isHome)
    {
    <a class="contact-shortcut" href="@whatsapp" target="_blank" rel="noopener" aria-label="@(en ? "Contact the salon on WhatsApp" : "WhatsApp ile salona ulaşın")">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.9L3 21l1.9-5.5a9 9 0 0 1-.9-4A8.5 8.5 0 0 1 12.5 3H13a8.5 8.5 0 0 1 8 8v.5Z"/><path d="m8 8 2 3 2 2 3 2"/></svg>
        <span>WhatsApp</span><span aria-hidden="true">↗</span>
    </a>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
