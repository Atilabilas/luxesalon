@using Microsoft.AspNetCore.Localization
@using LuxeSalon.Infrastructure.Data
@inject ApplicationDbContext DbContext
@inject LuxeSalon.Web.Services.SiteSettingsService SettingsService
@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.UICulture.Name ?? "tr";
    var settings = await SettingsService.GetSettingsAsync();
    
    // Loading text için veritabanından değer al
    var loadingText = DbContext.SiteContents.FirstOrDefault(c => c.Key == "loading_text")?.Value ?? settings.GetValueOrDefault("Site_Name", "LuxeSalon");
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @settings.GetValueOrDefault("Site_Name", "LuxeSalon")</title>
    <meta name="description" content="Celil Kuaför - İstanbul Nişantaşı'nda premium saç tasarım stüdyosu. Uzman stilistler, modern teknikler.">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
    
    <!-- Icons & Libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <!-- Alpine.js for interactive components -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    
    <!-- Styles -->
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
</head>
<body class="bg-luxe-ivory text-luxe-charcoal font-sans antialiased overflow-hidden">
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         LOADING SCREEN - Text Fill Effect with Background Slideshow
    ═══════════════════════════════════════════════════════════════════════ -->
    <div id="loading-overlay">
        <!-- Background Images Slideshow -->
        <div class="loading-bg-slideshow">
            <div class="loading-bg-slide active" style="background-image: url('https://images.unsplash.com/photo-1560066984-138dadb4c035?q=80&w=1920&auto=format&fit=crop')"></div>
            <div class="loading-bg-slide" style="background-image: url('https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?q=80&w=1920&auto=format&fit=crop')"></div>
            <div class="loading-bg-slide" style="background-image: url('https://images.unsplash.com/photo-1595476108010-b4d1f102b1b1?q=80&w=1920&auto=format&fit=crop')"></div>
            <div class="loading-bg-slide" style="background-image: url('https://images.unsplash.com/photo-1580618672591-eb180b1a973f?q=80&w=1920&auto=format&fit=crop')"></div>
        </div>
        <div class="loading-bg-overlay"></div>
        
        <!-- Loading Text -->
        <div class="loading-text-container">
            <h1 class="loading-text-outline">@loadingText</h1>
            <h1 class="loading-text-fill" id="loading-text-fill">@loadingText</h1>
        </div>
        <p class="loading-subtext">@(currentCulture == "en" ? "loading" : currentCulture == "de" ? "lädt" : "yükleniyor")</p>
        <p id="loading-percent" class="text-white/40 text-xs mt-4 tracking-[0.5em] uppercase">0%</p>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         HEADER / NAVIGATION
    ═══════════════════════════════════════════════════════════════════════ -->
    <header class="fixed w-full z-[100] transition-all duration-500 bg-white/95 backdrop-blur-md shadow-sm" id="main-header">
        <nav class="container mx-auto px-6 py-5 flex items-center justify-between">
            <!-- Logo -->
            <a href="/" class="text-2xl font-serif tracking-tight group text-luxe-charcoal">
                <span class="group-hover:text-luxe-gold transition-colors">@settings.GetValueOrDefault("Site_Name", "LuxeSalon")</span>
            </a>
            
            <!-- Desktop Menu -->
            @{
                var navItems = currentCulture switch {
                    "en" => new Dictionary<string, string> {
                        {"home", "Home"}, {"about", "About"}, {"services", "Services"}, 
                        {"blog", "Blog"}, {"shop", "Shop"}, {"appointment", "BOOK NOW"}
                    },
                    "de" => new Dictionary<string, string> {
                        {"home", "Startseite"}, {"about", "Über Uns"}, {"services", "Dienste"}, 
                        {"blog", "Blog"}, {"shop", "Shop"}, {"appointment", "TERMIN"}
                    },
                    _ => new Dictionary<string, string> {
                        {"home", "Anasayfa"}, {"about", "Hakkımızda"}, {"services", "Hizmetler"}, 
                        {"blog", "Blog"}, {"shop", "Mağaza"}, {"appointment", "RANDEVU AL"}
                    }
                };
            }
            <div class="hidden lg:flex items-center">
                <a href="/" style="margin-right: 2rem;" class="nav-link text-[11px] uppercase tracking-[0.2em] font-semibold text-luxe-charcoal hover:text-luxe-gold transition-colors">@navItems["home"]</a>
                <a href="/Hakkimizda" style="margin-right: 2rem;" class="nav-link text-[11px] uppercase tracking-[0.2em] font-semibold text-luxe-charcoal hover:text-luxe-gold transition-colors">@navItems["about"]</a>
                <a href="/Hizmetler" style="margin-right: 2rem;" class="nav-link text-[11px] uppercase tracking-[0.2em] font-semibold text-luxe-charcoal hover:text-luxe-gold transition-colors">@navItems["services"]</a>
                <a href="/Blog" style="margin-right: 2rem;" class="nav-link text-[11px] uppercase tracking-[0.2em] font-semibold text-luxe-charcoal hover:text-luxe-gold transition-colors">@navItems["blog"]</a>
                <a href="/Shop" style="margin-right: 2rem;" class="nav-link text-[11px] uppercase tracking-[0.2em] font-semibold text-luxe-charcoal hover:text-luxe-gold transition-colors">@navItems["shop"]</a>
                
                <!-- Language Switcher (with spacing) -->
                <div style="margin-right: 2rem;">
                    <partial name="_LanguageSwitcher" />
                </div>
                
                <a href="/Randevu" class="btn-primary py-4">@navItems["appointment"]</a>
            </div>
            
            <!-- Mobile Menu Button -->
            <button class="lg:hidden text-2xl" id="mobile-menu-btn" aria-label="Menü">
                <i class="fas fa-bars"></i>
            </button>
        </nav>
    </header>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-[99] bg-luxe-charcoal transform translate-x-full transition-transform duration-500 lg:hidden">
        <div class="flex flex-col items-center justify-center h-full space-y-8 text-white">
            <a href="/" class="text-3xl font-serif hover:text-luxe-gold transition-colors">Anasayfa</a>
            <a href="/Hakkimizda" class="text-3xl font-serif hover:text-luxe-gold transition-colors">Hakkımızda</a>
            <a href="/Hizmetler" class="text-3xl font-serif hover:text-luxe-gold transition-colors">Hizmetler</a>
            <a href="/Blog" class="text-3xl font-serif hover:text-luxe-gold transition-colors">Blog</a>
            <a href="/Shop" class="text-3xl font-serif hover:text-luxe-gold transition-colors">Mağaza</a>
            <a href="/Randevu" class="btn-white mt-8">RANDEVU AL</a>
        </div>
        <button class="absolute top-8 right-8 text-white text-3xl" id="mobile-menu-close">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MAIN CONTENT
    ═══════════════════════════════════════════════════════════════════════ -->
    <main>
        @RenderBody()
    </main>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FOOTER
    ═══════════════════════════════════════════════════════════════════════ -->
    <footer class="bg-luxe-charcoal text-white">
        @{
            var footerItems = currentCulture switch {
                "en" => new Dictionary<string, string> {
                    {"desc", "Providing premium hair design services in the heart of Izmir since 2010."},
                    {"links", "QUICK LINKS"}, {"contact", "CONTACT"}, {"follow", "FOLLOW US"},
                    {"copyright", "All rights reserved."}, {"design", "Design & Development"}
                },
                "de" => new Dictionary<string, string> {
                    {"desc", "Premium Haardesign-Dienstleistungen im Herzen von Izmir seit 2010."},
                    {"links", "SCHNELLLINKS"}, {"contact", "KONTAKT"}, {"follow", "FOLGEN SIE UNS"},
                    {"copyright", "Alle Rechte vorbehalten."}, {"design", "Design & Entwicklung"}
                },
                _ => new Dictionary<string, string> {
                    {"desc", "2010'dan bu yana İzmir'in kalbinde premium saç tasarım hizmetleri sunuyoruz."},
                    {"links", "HIZLI LİNKLER"}, {"contact", "İLETİŞİM"}, {"follow", "TAKİP EDİN"},
                    {"copyright", "Tüm hakları saklıdır."}, {"design", "Tasarım & Geliştirme"}
                }
            };
        }
        <div class="container mx-auto px-6 py-20">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
                <!-- Brand -->
                <div>
                    <a href="/" class="text-3xl font-serif font-semibold block mb-6">
                        @settings.GetValueOrDefault("Site_Name", "LuxeSalon")
                    </a>
                    <p class="text-white/80 font-normal text-base leading-relaxed">
                        @footerItems["desc"]
                    </p>
                </div>
                
                <!-- Quick Links -->
                <div>
                    <h4 class="text-sm uppercase tracking-[0.2em] text-luxe-gold font-bold mb-6">@footerItems["links"]</h4>
                    <ul class="space-y-3">
                        <li><a href="/" class="text-white/80 hover:text-white transition-colors font-medium">@navItems["home"]</a></li>
                        <li><a href="/Hakkimizda" class="text-white/80 hover:text-white transition-colors font-medium">@navItems["about"]</a></li>
                        <li><a href="/Blog" class="text-white/80 hover:text-white transition-colors font-medium">@navItems["blog"]</a></li>
                        <li><a href="/Shop" class="text-white/80 hover:text-white transition-colors font-medium">@navItems["shop"]</a></li>
                    </ul>
                </div>
                
                <!-- Contact -->
                <div>
                    <h4 class="text-sm uppercase tracking-[0.2em] text-luxe-gold font-bold mb-6">@footerItems["contact"]</h4>
                    <ul class="space-y-3 text-white/80 font-medium text-base">
                        <li>@settings.GetValueOrDefault("Contact_Address", "Address")</li>
                        <li>@settings.GetValueOrDefault("Contact_City", "City")</li>
                        <li class="pt-2">@settings.GetValueOrDefault("Contact_Phone", "Phone")</li>
                        <li>@settings.GetValueOrDefault("Contact_Email", "Email")</li>
                    </ul>
                </div>
                
                <!-- Social -->
                <div>
                    <h4 class="text-sm uppercase tracking-[0.2em] text-luxe-gold font-bold mb-6">@footerItems["follow"]</h4>
                    <div class="flex space-x-4">
                        <a href="#" class="w-12 h-12 border border-white/30 flex items-center justify-center hover:bg-luxe-gold hover:border-luxe-gold transition-all">
                            <i class="fab fa-instagram"></i>
                        </a>
                        <a href="#" class="w-12 h-12 border border-white/30 flex items-center justify-center hover:bg-luxe-gold hover:border-luxe-gold transition-all">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#" class="w-12 h-12 border border-white/30 flex items-center justify-center hover:bg-luxe-gold hover:border-luxe-gold transition-all">
                            <i class="fab fa-pinterest-p"></i>
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="border-t border-white/20 pt-8 flex flex-col md:flex-row justify-between items-center text-white/70 text-base font-medium">
                <p>&copy; @DateTime.Now.Year @settings.GetValueOrDefault("Site_Name", "LuxeSalon"). @footerItems["copyright"]</p>
                <p class="mt-4 md:mt-0">@footerItems["design"]</p>
            </div>
        </div>
    </footer>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WHATSAPP FLOATING BUTTON
    ═══════════════════════════════════════════════════════════════════════ -->
    @if(!string.IsNullOrEmpty(settings.GetValueOrDefault("Whatsapp_Number")))
    {
        <a href="https://wa.me/@settings["Whatsapp_Number"]?text=Merhaba" 
           target="_blank"
           class="fixed bottom-8 right-8 z-[90] w-16 h-16 bg-[#25D366] rounded-full flex items-center justify-center shadow-2xl hover:scale-110 transition-transform duration-300 hover:shadow-green-500/40"
           aria-label="WhatsApp">
            <i class="fab fa-whatsapp text-white text-3xl"></i>
        </a>
    }

    <!-- ═══════════════════════════════════════════════════════════════════════
         SCRIPTS
    ═══════════════════════════════════════════════════════════════════════ -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // ═════════════════════════════════════════════════════════════
            // LOADING SCREEN - Text Fill Animation with Background Slideshow
            // ═════════════════════════════════════════════════════════════
            let progress = 0;
            const loadingTextFill = document.getElementById('loading-text-fill');
            const loadingPercent = document.getElementById('loading-percent');
            const loadingOverlay = document.getElementById('loading-overlay');
            const bgSlides = document.querySelectorAll('.loading-bg-slide');
            let currentSlide = 0;

            // Background slideshow rotation
            const slideInterval = setInterval(() => {
                bgSlides[currentSlide].classList.remove('active');
                currentSlide = (currentSlide + 1) % bgSlides.length;
                bgSlides[currentSlide].classList.add('active');
            }, 1500);

            const loadingInterval = setInterval(() => {
                progress += Math.random() * 6 + 2;
                if (progress >= 100) {
                    progress = 100;
                    clearInterval(loadingInterval);
                    clearInterval(slideInterval);
                    setTimeout(() => {
                        loadingOverlay.style.opacity = '0';
                        document.body.classList.remove('overflow-hidden');
                        setTimeout(() => {
                            loadingOverlay.style.display = 'none';
                        }, 800);
                    }, 500);
                }
                loadingTextFill.style.width = progress + '%';
                loadingPercent.textContent = Math.round(progress) + '%';
            }, 80);

            // ═════════════════════════════════════════════════════════════
            // HEADER SCROLL EFFECT (Simplified - dark text by default)
            // ═════════════════════════════════════════════════════════════
            const header = document.getElementById('main-header');
            // Header is now always visible with dark background - no scroll logic needed for visibility

            // ═════════════════════════════════════════════════════════════
            // MOBILE MENU
            // ═════════════════════════════════════════════════════════════
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenuClose = document.getElementById('mobile-menu-close');
            const mobileMenu = document.getElementById('mobile-menu');

            if (mobileMenuBtn && mobileMenu) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenu.classList.remove('translate-x-full');
                });
            }

            if (mobileMenuClose && mobileMenu) {
                mobileMenuClose.addEventListener('click', () => {
                    mobileMenu.classList.add('translate-x-full');
                });
            }

            // Close mobile menu when clicking a link
            mobileMenu.querySelectorAll('a').forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('translate-x-full');
                });
            });

            // ═════════════════════════════════════════════════════════════
            // SMOOTH SCROLL
            // ═════════════════════════════════════════════════════════════
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
