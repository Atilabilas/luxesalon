<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Celil Kuaför Admin</title>
    <link rel="stylesheet" href="~/css/output.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
</head>
<body class="bg-luxe-ivory text-luxe-charcoal font-sans antialiased">
    <div class="flex h-screen">
        @* Sidebar *@
        <aside class="w-64 bg-luxe-charcoal text-white flex-shrink-0">
            <div class="p-6 border-b border-white/10">
                <a href="/" class="text-2xl font-serif">
                    Celil <span class="font-light italic">Kuaför</span>
                </a>
                <p class="text-white/40 text-xs mt-1">Yönetim Paneli</p>
            </div>
            
            <nav class="p-4 space-y-2">
                <a href="/Admin" class="flex items-center gap-3 px-4 py-3 hover:bg-white/10 transition-colors text-sm font-medium">
                    <i class="fas fa-home w-5"></i> Dashboard
                </a>
                <a href="/Admin/SiteImages" class="flex items-center gap-3 px-4 py-3 hover:bg-white/10 transition-colors text-sm font-medium">
                    <i class="fas fa-images w-5"></i> Site Görselleri
                </a>
                <a href="/Admin/Team" class="flex items-center gap-3 px-4 py-3 hover:bg-white/10 transition-colors text-sm font-medium">
                    <i class="fas fa-users w-5"></i> Ekip Yönetimi
                </a>
                <a href="/Admin/Pricing" class="flex items-center gap-3 px-4 py-3 hover:bg-white/10 transition-colors text-sm font-medium">
                    <i class="fas fa-tag w-5"></i> Fiyat Listesi
                </a>
                <a href="/Admin/Content" class="flex items-center gap-3 px-4 py-3 hover:bg-white/10 transition-colors text-sm font-medium bg-luxe-gold/20">
                    <i class="fas fa-edit w-5"></i> Site İçerikleri
                </a>
                
                <div class="border-t border-white/10 my-4"></div>
                
                <a href="/Admin/Blog" class="flex items-center gap-3 px-4 py-3 hover:bg-white/10 transition-colors text-sm font-medium">
                    <i class="fas fa-newspaper w-5"></i> Blog Yazıları
                </a>
                <a href="/Admin/Products" class="flex items-center gap-3 px-4 py-3 hover:bg-white/10 transition-colors text-sm font-medium">
                    <i class="fas fa-box w-5"></i> Ürünler
                </a>
                
                <div class="border-t border-white/10 my-4"></div>
                
                <a href="/" class="flex items-center gap-3 px-4 py-3 hover:bg-white/10 transition-colors text-sm font-medium text-luxe-gold">
                    <i class="fas fa-external-link-alt w-5"></i> Siteyi Görüntüle
                </a>
                <a href="/Admin/Logout" class="flex items-center gap-3 px-4 py-3 hover:bg-red-500/30 transition-colors text-sm font-medium text-red-400 mt-auto">
                    <i class="fas fa-sign-out-alt w-5"></i> Çıkış Yap
                </a>
            </nav>
        </aside>

        @* Main Content *@
        <main class="flex-1 overflow-y-auto">
            <div class="p-8">
                @RenderBody()
            </div>
        </main>
    </div>
</body>
</html>
