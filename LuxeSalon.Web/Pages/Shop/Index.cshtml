@page "/magaza"
@model LuxeSalon.Web.Pages.Shop.IndexModel
@{
    ViewData["Title"] = Model.GetContent("shop_page_title");
    ViewData["Robots"] = "noindex, follow";
    ViewData["MetaDescription"] = Model.GetContent("shop_empty_desc", "Salon ürün seçkisi hazırlanıyor.");
    ViewData["Canonical"] = (Model.Setting("Site_Url", "https://celilatilla.com").TrimEnd('/')) + (Model.CurrentCulture == "en" ? "/en/shop" : "/magaza");
}

@* Hero Banner *@
<section class="relative h-[50vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        @if (Model.HeroImage != null)
        {
            <img src="@Model.HeroImage.ImageUrl"
                 alt="@(Model.HeroImage.AltText ?? Model.HeroImage.Title ?? Model.GetContent("shop_hero_title"))"
                 class="w-full h-full object-cover" />
        }
        <div class="absolute inset-0 bg-luxe-charcoal/60"></div>
    </div>
    <div class="relative z-10 text-center text-white">
        <p class="section-subtitle text-luxe-gold mb-4">@Model.GetContent("shop_hero_subtitle")</p>
        <h1 class="section-title text-white">@Model.GetContent("shop_hero_title")</h1>
    </div>
</section>

<section class="section-padding bg-luxe-ivory">
    <div class="container mx-auto">
        @if (!Model.Products.Any())
        {
            <div class="text-center py-20">
                <p class="text-4xl font-serif italic text-luxe-charcoal/30 mb-8">@Model.GetContent("shop_empty_title")</p>
                <p class="text-lg text-luxe-charcoal/50">@Model.GetContent("shop_empty_desc")</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                @foreach (var product in Model.Products)
                {
                    <div class="group reveal">
                        <a asp-page="./Details" asp-route-id="@product.Id" class="block">
                            <div class="aspect-square bg-luxe-cream mb-6 overflow-hidden">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name"
                                         class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-luxe-cream to-luxe-ivory">
                                        <span class="text-6xl font-serif italic text-luxe-charcoal/10">@Model.Setting("Site_Name", "L")[0]</span>
                                    </div>
                                }
                            </div>
                            <div class="text-center">
                                <p class="text-[10px] uppercase tracking-[0.4em] text-luxe-gold font-bold mb-2">@product.Category</p>
                                <h3 class="text-xl font-serif mb-3 group-hover:text-luxe-gold transition-colors">@product.Name</h3>
                                <p class="text-lg font-light text-luxe-charcoal/60">@product.Price.ToString("C0")</p>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>

@* Featured Section *@
<section class="bg-luxe-charcoal text-white py-20 md:py-24">
    <div class="container mx-auto px-6 text-center">
        <p class="section-subtitle text-luxe-gold">@Model.GetContent("shop_why_subtitle")</p>
        <h2 class="section-title text-white mb-12">@Model.GetContent("shop_why_title")</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 max-w-4xl mx-auto">
            <div class="reveal">
                <div class="text-5xl font-serif text-luxe-gold mb-4">01</div>
                <h3 class="text-xl font-serif mb-4">@Model.GetContent("shop_why_1_title")</h3>
                <p class="text-white/60 font-light">@Model.GetContent("shop_why_1_desc")</p>
            </div>
            <div class="reveal">
                <div class="text-5xl font-serif text-luxe-gold mb-4">02</div>
                <h3 class="text-xl font-serif mb-4">@Model.GetContent("shop_why_2_title")</h3>
                <p class="text-white/60 font-light">@Model.GetContent("shop_why_2_desc")</p>
            </div>
            <div class="reveal">
                <div class="text-5xl font-serif text-luxe-gold mb-4">03</div>
                <h3 class="text-xl font-serif mb-4">@Model.GetContent("shop_why_3_title")</h3>
                <p class="text-white/60 font-light">@Model.GetContent("shop_why_3_desc")</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
}
