@page "{id:int}"
@model LuxeSalon.Web.Pages.Shop.DetailsModel
@{
    ViewData["Title"] = Model.Product.Name + Model.Setting("Shop_Title_Suffix");
}

<section class="section-light pt-40 pb-32">
    <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-24 items-start">
            <div class="bg-white aspect-square flex items-center justify-center p-20 reveal-left">
                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                {
                    <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" class="w-full h-full object-cover transition-transform duration-1000 hover:scale-105" />
                }
                else
                {
                    <div class="text-[10px] uppercase tracking-[0.5em] text-gray-300 font-bold italic">@Model.GetContent("shop_details_no_image")</div>
                }
            </div>

            <div class="pt-8 reveal-right">
                <nav class="flex items-center space-x-4 mb-12 text-[9px] uppercase tracking-widest font-bold text-gray-400">
                    <a asp-page="./Index" class="hover:text-luxe-charcoal transition-colors">@Model.GetContent("shop_hero_title")</a>
                    <span>/</span>
                    <span class="text-luxe-gold">@Model.Product.Category</span>
                </nav>

                <h1 class="text-5xl font-serif mb-6 tracking-tighter">@Model.Product.Name</h1>
                <div class="text-2xl font-serif italic text-luxe-gold mb-12">@Model.Product.Price.ToString("C0")</div>

                <div class="h-[1px] w-full bg-luxe-charcoal/5 mb-12"></div>

                <div class="prose prose-sm font-light text-gray-600 mb-16 leading-relaxed">
                    @Model.Product.Description
                </div>

                <div class="flex flex-col space-y-4 mb-16">
                    <button class="w-full bg-luxe-charcoal text-luxe-ivory py-5 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-luxe-gold transition-all duration-700">
                        @Model.GetContent("shop_add_cart")
                    </button>
                    <div class="flex justify-between items-center text-[9px] uppercase tracking-widest font-bold text-gray-400 px-2">
                        <span>@Model.GetContent("shop_details_shipping")</span>
                        <span>@Model.GetContent("shop_stock_label") @Model.Product.StockQuantity</span>
                    </div>
                </div>

                <div class="space-y-6">
                    <details class="group border-b border-luxe-charcoal/5 pb-4 cursor-pointer">
                        <summary class="list-none flex justify-between items-center text-[10px] uppercase tracking-widest font-bold">
                            @Model.GetContent("shop_details_accordion_title")
                            <span class="transform group-open:rotate-45 transition-transform">+</span>
                        </summary>
                        <p class="mt-4 text-xs font-light text-gray-500 leading-relaxed">
                            @Model.GetContent("shop_details_placeholder")
                        </p>
                    </details>
                    <details class="group border-b border-luxe-charcoal/5 pb-4 cursor-pointer">
                        <summary class="list-none flex justify-between items-center text-[10px] uppercase tracking-widest font-bold">
                            @Model.GetContent("shop_details_shipping_title")
                            <span class="transform group-open:rotate-45 transition-transform">+</span>
                        </summary>
                        <p class="mt-4 text-xs font-light text-gray-500 leading-relaxed">
                            @Model.GetContent("shop_details_shipping_desc")
                        </p>
                    </details>
                </div>
            </div>
        </div>
    </div>
</section>
