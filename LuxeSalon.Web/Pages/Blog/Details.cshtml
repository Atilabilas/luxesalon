@page "{id:int}"
@model LuxeSalon.Web.Pages.Blog.DetailsModel
@{
    ViewData["Title"] = Model.BlogPost.Title + " — Celil Kuaför Dergi";
}

<article class="section-light pt-40 pb-32">
    <div class="container mx-auto px-6 max-w-4xl reveal">
        <div class="text-center mb-20">
            <div class="flex items-center justify-center space-x-4 mb-8">
                <span class="text-[10px] uppercase tracking-[0.4em] font-bold text-luxe-gold">@Model.BlogPost.PublishedAt.ToString("MMMM dd, yyyy")</span>
                <div class="h-[1px] w-8 bg-luxe-charcoal/20"></div>
                <span class="text-[10px] uppercase tracking-[0.4em] font-bold text-gray-400">@Model.BlogPost.Author</span>
            </div>
            <h1 class="text-5xl md:text-7xl font-serif mb-12 leading-tight tracking-tighter italic">@Model.BlogPost.Title</h1>
        </div>

        @if (!string.IsNullOrEmpty(Model.BlogPost.HeaderImageUrl))
        {
            <div class="aspect-[16/9] mb-20 overflow-hidden bg-gray-100 reveal">
                <img src="@Model.BlogPost.HeaderImageUrl" alt="@Model.BlogPost.Title" class="w-full h-full object-cover" />
            </div>
        }

        <div class="prose prose-lg max-w-none font-light leading-relaxed text-gray-700 reveal">
            <div class="mb-12 text-xl font-serif italic text-luxe-charcoal/80 bg-luxe-ivory p-8 border-l-2 border-luxe-gold">
                @Model.BlogPost.Summary
            </div>
            
            @Html.Raw(Model.BlogPost.Content)
        </div>

        <div class="mt-24 pt-12 border-t border-luxe-charcoal/5 flex justify-between items-center reveal">
            <a asp-page="./Index" class="text-[10px] uppercase tracking-widest font-bold text-gray-400 hover:text-luxe-charcoal transition-colors">← Dergiye Dön</a>
            <div class="flex space-x-6 text-[10px] uppercase tracking-widest font-bold">
                <span class="text-gray-300">Share:</span>
                <a href="#" class="hover:text-luxe-gold transition-colors">Twitter</a>
                <a href="#" class="hover:text-luxe-gold transition-colors">Pinterest</a>
            </div>
        </div>
    </div>
</article>
