@page "/blog"
@model LuxeSalon.Web.Pages.Blog.IndexModel
@{
    var culture = Model.CurrentCulture;
    Model.SetSeo(
        Model.GetContent("blog_page_title", culture == "en" ? "Hair Guide | Celil & Atilla" : "Saç Rehberi | Celil & Atilla"),
        culture == "en"
            ? "Practical guides on colour, cutting and care from Celil & Atilla in Kazımdirik, Bornova, İzmir. Prepare your questions before arranging a salon visit."
            : "İzmir Bornova’daki Celil & Atilla’dan saç kesimi, balyaj, ombre, keratin ve gelin saçı rehberleri. İşlem öncesi sorularınızı ve randevu hazırlığını planlayın.",
        LuxeSalon.Web.Services.SitePaths.Blog(culture),
        Model.HeroImage?.ImageUrl,
        "website",
        null,
        LuxeSalon.Web.Services.SitePaths.Blog("tr"),
        LuxeSalon.Web.Services.SitePaths.Blog("en"));
}

<section class="relative h-[50vh] min-h-[400px] flex items-end pb-16 overflow-hidden">
    @if (Model.HeroImage != null)
    {
        <div class="absolute inset-0">
            <img src="@Model.HeroImage.ImageUrl"
                 alt="@(Model.HeroImage.AltText ?? Model.GetContent("blog_hero_title"))"
                 class="w-full h-full object-cover"
                 loading="eager" fetchpriority="high" decoding="async" width="1600" height="900" />
            <div class="absolute inset-0 bg-gradient-to-t from-luxe-charcoal/70 via-luxe-charcoal/30 to-transparent"></div>
        </div>
    }
    else
    {
        <div class="absolute inset-0 bg-luxe-charcoal"></div>
    }
    <div class="container mx-auto px-6 relative z-10 text-white">
        <p class="text-[10px] uppercase tracking-[0.4em] text-luxe-gold mb-4">@Model.GetContent("blog_hero_subtitle")</p>
        <h1 class="text-4xl md:text-6xl font-serif">@Model.GetContent("blog_hero_title")</h1>
        <p class="text-sm mt-6 max-w-2xl">@(culture == "en" ? "From our salon in Bornova, İzmir: guides to choosing a service, preparing your questions and caring for your hair." : "İzmir’in Bornova ilçesindeki salonumuzdan; işlem seçimi, randevu öncesi sorular ve saç bakımı üzerine rehberler.")</p>
    </div>
</section>

<section class="py-20 md:py-28">
    <div class="container mx-auto px-6">
        @if (!Model.BlogPosts.Any())
        {
            <div class="text-center py-20">
                <h2 class="text-2xl font-serif mb-4">@Model.GetContent("blog_empty_title")</h2>
                <p class="text-luxe-charcoal/60">@Model.GetContent("blog_empty_desc")</p>
            </div>
        }
        else
        {
            var featured = Model.BlogPosts.First();
            var featuredSlug = featured.LocalizedSlug(culture);
            <div class="grid lg:grid-cols-2 gap-10 mb-20 items-center">
                <a href="@LuxeSalon.Web.Services.SitePaths.BlogPost(culture, featuredSlug)" class="block overflow-hidden aspect-[4/3] bg-luxe-cream">
                    @if (!string.IsNullOrEmpty(featured.HeaderImageUrl))
                    {
                        <img src="@featured.HeaderImageUrl" alt="@featured.LocalizedTitle(culture)"
                             class="w-full h-full object-cover hover:scale-105 transition-transform duration-1000"
                             loading="eager" decoding="async" width="900" height="675" />
                    }
                </a>
                <div>
                    <p class="text-[10px] uppercase tracking-[0.3em] text-luxe-gold mb-4">@featured.PublishedAt.ToString("dd MMMM yyyy") — @featured.Author</p>
                    <h2 class="text-3xl md:text-4xl font-serif mb-4">
                        <a href="@LuxeSalon.Web.Services.SitePaths.BlogPost(culture, featuredSlug)" class="hover:text-luxe-gold transition-colors">
                            @featured.LocalizedTitle(culture)
                        </a>
                    </h2>
                    <p class="text-luxe-charcoal/70 font-light leading-relaxed mb-8">@featured.LocalizedSummary(culture)</p>
                    <a href="@LuxeSalon.Web.Services.SitePaths.BlogPost(culture, featuredSlug)" class="btn-primary inline-block w-fit">@Model.GetContent("blog_read_more")</a>
                </div>
            </div>

            @if (Model.BlogPosts.Count > 1)
            {
                <h2 class="text-2xl font-serif mb-10">@Model.GetContent("blog_other_posts")</h2>
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    @foreach (var post in Model.BlogPosts.Skip(1))
                    {
                        var postSlug = post.LocalizedSlug(culture);
                        <a href="@LuxeSalon.Web.Services.SitePaths.BlogPost(culture, postSlug)" class="block group">
                            @if (!string.IsNullOrEmpty(post.HeaderImageUrl))
                            {
                                <div class="aspect-[4/3] overflow-hidden bg-luxe-cream mb-4">
                                    <img src="@post.HeaderImageUrl" alt="@post.LocalizedTitle(culture)"
                                         class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                                         loading="lazy" decoding="async" width="600" height="450" />
                                </div>
                            }
                            <p class="text-[10px] uppercase tracking-widest text-luxe-charcoal/40 mb-2">@post.PublishedAt.ToString("dd MMM yyyy")</p>
                            <h3 class="font-serif text-xl group-hover:text-luxe-gold transition-colors">@post.LocalizedTitle(culture)</h3>
                        </a>
                    }
                </div>
            }
        }
    </div>
</section>
