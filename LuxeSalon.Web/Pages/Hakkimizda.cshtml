@page "/hakkimizda"
@model LuxeSalon.Web.Pages.HakkimizdaModel
@using LuxeSalon.Web.Services
@{
    var en = Model.CurrentCulture == "en";
    var culture = Model.CurrentCulture;
    var celil = Model.TeamMembers.FirstOrDefault(m => m.Name.Equals("Celil", StringComparison.OrdinalIgnoreCase));
    Model.SetSeo(en ? "About the salon | Celil & Atilla" : "Salon ve ekip | Celil & Atilla",
        en ? "Meet Celil and the team at Celil & Atilla, a Bornova hair salon founded in 2000. Cut, colour and care in Kazımdirik, İzmir."
           : "2000’de Bornova’da kurulan Celil & Atilla’yı, kurucu Celil’i ve ekibi tanıyın. Kazımdirik’te saç kesimi, renklendirme ve bakım.",
        SitePaths.About(culture), Model.AboutImage?.ImageUrl, "website", null, SitePaths.About("tr"), SitePaths.About("en"));
}
<section class="atelier-page-intro">
    <div class="atelier-container">
        <p class="eyebrow">@(en ? "The salon / 01" : "Salon / 01")</p>
        <h1>@(en ? "A place for your hair." : "Saçınız için bir yer.")<br /><em>@(en ? "And a familiar face." : "Tanıdık bir yüz.")</em></h1>
        <p>@(en ? "Celil & Atilla began in Bornova in 2000. Today, we welcome you for cut, colour and care at our salon in Kazımdirik." : "Celil & Atilla’nın hikâyesi 2000’de Bornova’da başladı. Bugün Kazımdirik’teki salonumuzda kesim, renk ve bakım için sizi ağırlıyoruz.")</p>
    </div>
</section>

<section class="atelier-section">
    <div class="atelier-container story-grid">
        <div class="story-photo">
            @if (Model.AboutImage != null)
            {
                <img src="@Model.AboutImage.ImageUrl" alt="@(en ? "Illustrative salon interior with styling chairs and mirrors" : "Kesim koltukları ve aynalar bulunan temsili salon iç mekânı")" loading="eager" fetchpriority="high" sizes="(max-width: 767px) 100vw, 46vw" />
                @if (Model.AboutImage.ImageUrl.Contains("unsplash.com")) { <span class="atelier-image-caption">@(en ? "Illustrative image" : "Temsili görsel")</span> }
            }
        </div>
        <div class="story-copy">
            <p class="eyebrow">@(en ? "Our story / 02" : "Hikâyemiz / 02")</p>
            <h2>@Model.GetContent("hakkimizda_story_title", en ? "Hair, with attention." : "Saça özenle.")</h2>
            <p>@Model.GetContent("hakkimizda_story_p1")</p>
            <p>@Model.GetContent("hakkimizda_story_p2")</p>
            <p>@Model.GetContent("hakkimizda_story_p3")</p>
            <a class="editorial-link" href="@SitePaths.Services(culture)">@(en ? "Explore the services" : "Hizmetleri inceleyin") <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</section>

@if (celil != null)
{
    <section class="atelier-founder" id="celil" aria-labelledby="celil-title">
        <div class="atelier-container atelier-founder-grid">
            <div>
                <p class="eyebrow">@(en ? "The founder / 03" : "Kurucu / 03")</p>
                <h2 id="celil-title">Celil</h2>
                <p class="atelier-founder-role">@(en ? "Founder · Cut & colour" : "Kurucu · Kesim ve renk")</p>
            </div>
            <div>
                <p>@(en ? "Celil is the founder of Celil & Atilla. He runs the salon and works on hair cutting and colouring. You can speak to him about your hair history, the shape you want and your next appointment." : "Celil, Celil & Atilla’nın kurucusudur. Salonu yürütür; saç kesimi ve renklendirme üzerine çalışır. Saçınızın geçmişini, istediğiniz formu ve randevunuzu kendisiyle konuşabilirsiniz.")</p>
                <a class="editorial-link" href="@SitePaths.Appointment(culture)">@(en ? "Arrange a visit" : "Randevu için iletişime geçin") <span aria-hidden="true">↗</span></a>
            </div>
        </div>
    </section>
}

<section class="atelier-section" id="ekip" aria-labelledby="team-title">
    <div class="atelier-container">
        <div class="section-heading">
            <div><p class="eyebrow">@(en ? "People / 04" : "Ekip / 04")</p><h2 id="team-title">@(en ? "Meet the team." : "Tanışalım.")</h2></div>
            <p>@(en ? "The people who welcome you at the salon." : "Salonda sizi karşılayan isimler.")</p>
        </div>
        <div class="atelier-team-grid">
            @foreach (var member in Model.TeamMembers)
            {
                var role = en ? member.Name switch { "Celil" => "Founder · Cut & colour", "Bülent" => "Stylist", "Tuğba" => "Stylist · Manicure", "Sevgül" => "Manicure", _ => "Salon assistant" } : member.Role;
                <article class="atelier-team-card">
                    @if (!string.IsNullOrWhiteSpace(member.ImageUrl) && !member.ImageUrl.Contains("unsplash.com") && !member.ImageUrl.Contains("pravatar"))
                    {
                        <img src="@member.ImageUrl" alt="@member.Name" loading="lazy" sizes="(max-width: 767px) 45vw, 30vw" />
                    }
                    else
                    {
                        <div class="atelier-team-initial" aria-hidden="true">@(member.Name.Length > 0 ? member.Name[..1] : "")</div>
                    }
                    <h3>@member.Name</h3><p>@role</p>
                    @if (!en && !string.IsNullOrWhiteSpace(member.Bio)) { <p class="atelier-team-bio">@member.Bio</p> }
                </article>
            }
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            ViewData["EditUrl"] = "/Admin/Team";
            <partial name="_EditButton" />
        }
    </div>
</section>

<section class="atelier-invitation">
    <div class="atelier-container">
        <p class="eyebrow">@(en ? "Your next visit" : "Bir sonraki ziyaretiniz")</p>
        <h2>@(en ? "Let's talk about your hair." : "Saçınız üzerine konuşalım.")</h2>
        <a href="@SitePaths.Appointment(culture)" class="atelier-button">@(en ? "Request an appointment" : "Randevu talebi oluştur") <span aria-hidden="true">↗</span></a>
    </div>
</section>
