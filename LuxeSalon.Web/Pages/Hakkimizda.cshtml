@page
@model LuxeSalon.Web.Pages.HakkimizdaModel
@{
    ViewData["Title"] = "Celil Kuaför Hakkında — İzmir'in Önde Gelen Kuaförü";
}

@* Hero Section *@
<section class="relative h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1595476108010-b4d1f102b1b1?q=80&w=1920&auto=format&fit=crop" 
             alt="Celil Kuaför" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-luxe-charcoal/70"></div>
    </div>
    <div class="relative z-10 text-center text-white px-6 max-w-4xl">
        <p class="text-sm uppercase tracking-[0.5em] text-luxe-gold font-bold mb-6 reveal">Kurucu & Sanat Yönetmeni</p>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-serif mb-8 reveal">
            Celil<br/><span class="italic font-light">Kuaför</span>
        </h1>
        <p class="text-xl md:text-2xl font-light text-white/80 reveal">
            "Saç, bir kadının taç'ıdır. Benim işim onu parlatmak."
        </p>
    </div>
</section>

@* Story Section *@
<section class="section-padding bg-luxe-ivory">
    <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
            @* Left: Image *@
            <div class="reveal-left">
                <div class="relative">
                    <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?q=80&w=800&auto=format&fit=crop" 
                         alt="Celil" class="w-full aspect-[3/4] object-cover" />
                    <div class="absolute -bottom-8 -right-8 bg-luxe-gold text-white p-8 hidden md:block">
                        <p class="text-5xl font-serif">20+</p>
                        <p class="text-sm uppercase tracking-widest">Yıllık Deneyim</p>
                    </div>
                </div>
            </div>

            @* Right: Story *@
            <div class="reveal-right">
                <p class="section-subtitle">Hikayemiz</p>
                <h2 class="text-4xl md:text-5xl font-serif mb-8 leading-tight">
                    İzmir'in Kalbinde<br/><span class="italic">Bir Tutku Hikayesi</span>
                </h2>
                <div class="space-y-6 text-lg font-light text-luxe-charcoal/70 leading-relaxed">
                    <p>
                        <strong class="text-luxe-charcoal">Celil Kuaför</strong>, 2004 yılında İzmir Alsancak'ta 
                        küçük bir salon olarak hayata başladı. Kurucumuz Celil, henüz 18 yaşındayken 
                        saç sanatına olan tutkusunu keşfetti ve İstanbul'un en prestijli salonlarında 
                        yıllarını verdi.
                    </p>
                    <p>
                        İzmir'e döndüğünde tek bir hedefi vardı: Ege'nin incisi olan bu şehre, 
                        uluslararası standartlarda bir saç tasarım stüdyosu kazandırmak. Bugün, 
                        <strong class="text-luxe-charcoal">İzmir'in en çok tercih edilen kadın kuaförlerinden biri</strong> 
                        olarak binlerce müşteriye hizmet veriyoruz.
                    </p>
                    <p>
                        Her müşterimiz bizim için özeldir. Her saç, bir tuval; her kesim, bir sanat eseridir. 
                        Amacımız sadece saç kesmek değil, her kadının kendini en güzel hissettiği 
                        görünümü yaratmaktır.
                    </p>
                </div>

                <div class="grid grid-cols-3 gap-8 mt-12 pt-12 border-t border-luxe-charcoal/10">
                    <div>
                        <p class="text-4xl font-serif text-luxe-gold">15K+</p>
                        <p class="text-sm text-luxe-charcoal/60 uppercase tracking-wider mt-2">Mutlu Müşteri</p>
                    </div>
                    <div>
                        <p class="text-4xl font-serif text-luxe-gold">8</p>
                        <p class="text-sm text-luxe-charcoal/60 uppercase tracking-wider mt-2">Uzman Stilist</p>
                    </div>
                    <div>
                        <p class="text-4xl font-serif text-luxe-gold">50+</p>
                        <p class="text-sm text-luxe-charcoal/60 uppercase tracking-wider mt-2">Ödül</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* Philosophy Section *@
<section class="bg-luxe-charcoal text-white py-32">
    <div class="container mx-auto px-6 text-center max-w-4xl reveal">
        <p class="section-subtitle text-luxe-gold">Felsefemiz</p>
        <blockquote class="text-3xl md:text-4xl lg:text-5xl font-serif italic leading-relaxed mb-12">
            "Güzellik, kendine güvenle başlar. Biz sadece saçınızı değil, 
            özgüveninizi de şekillendiriyoruz."
        </blockquote>
        <p class="text-white/60">— Celil, Kurucu</p>
    </div>
</section>

@* Team Section *@
<section class="section-padding bg-luxe-ivory">
    <div class="container mx-auto">
        <div class="text-center mb-16 reveal">
            <p class="section-subtitle">Ekibimiz</p>
            <h2 class="section-title">Uzman Stilistler</h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
            @* Team Member 1 *@
            <div class="group reveal">
                <div class="aspect-[3/4] overflow-hidden mb-4">
                    <img src="https://images.unsplash.com/photo-1580618672591-eb180b1a973f?q=80&w=400&auto=format&fit=crop" 
                         alt="Stilist" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                </div>
                <h4 class="font-serif text-lg">Ayşe Yılmaz</h4>
                <p class="text-sm text-luxe-charcoal/60">Renk Uzmanı</p>
            </div>

            @* Team Member 2 *@
            <div class="group reveal">
                <div class="aspect-[3/4] overflow-hidden mb-4">
                    <img src="https://images.unsplash.com/photo-1595959183082-7b570b7e1dfa?q=80&w=400&auto=format&fit=crop" 
                         alt="Stilist" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                </div>
                <h4 class="font-serif text-lg">Zeynep Kaya</h4>
                <p class="text-sm text-luxe-charcoal/60">Kesim Uzmanı</p>
            </div>

            @* Team Member 3 *@
            <div class="group reveal">
                <div class="aspect-[3/4] overflow-hidden mb-4">
                    <img src="https://images.unsplash.com/photo-1559599101-f09722fb4948?q=80&w=400&auto=format&fit=crop" 
                         alt="Stilist" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                </div>
                <h4 class="font-serif text-lg">Elif Demir</h4>
                <p class="text-sm text-luxe-charcoal/60">Gelin Saçı Uzmanı</p>
            </div>

            @* Team Member 4 *@
            <div class="group reveal">
                <div class="aspect-[3/4] overflow-hidden mb-4">
                    <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?q=80&w=400&auto=format&fit=crop" 
                         alt="Stilist" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                </div>
                <h4 class="font-serif text-lg">Selin Öztürk</h4>
                <p class="text-sm text-luxe-charcoal/60">Makyaj Artisti</p>
            </div>
        </div>
    </div>
</section>

@* Awards & Recognition *@
<section class="section-padding bg-luxe-cream">
    <div class="container mx-auto text-center">
        <div class="reveal mb-16">
            <p class="section-subtitle">Başarılarımız</p>
            <h2 class="section-title">Ödüller & Takdirler</h2>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto">
            <div class="reveal p-6">
                <p class="text-3xl font-serif text-luxe-gold mb-2">🏆</p>
                <p class="font-serif text-lg mb-1">En İyi Salon</p>
                <p class="text-sm text-luxe-charcoal/60">İzmir 2023</p>
            </div>
            <div class="reveal p-6">
                <p class="text-3xl font-serif text-luxe-gold mb-2">⭐</p>
                <p class="font-serif text-lg mb-1">5 Yıldız</p>
                <p class="text-sm text-luxe-charcoal/60">Google Reviews</p>
            </div>
            <div class="reveal p-6">
                <p class="text-3xl font-serif text-luxe-gold mb-2">🎨</p>
                <p class="font-serif text-lg mb-1">Renk Ustası</p>
                <p class="text-sm text-luxe-charcoal/60">L'Oréal 2022</p>
            </div>
            <div class="reveal p-6">
                <p class="text-3xl font-serif text-luxe-gold mb-2">💎</p>
                <p class="font-serif text-lg mb-1">Premium Salon</p>
                <p class="text-sm text-luxe-charcoal/60">Wella Partner</p>
            </div>
        </div>
    </div>
</section>

@* CTA Section *@
<section class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 z-0">
        <img src="https://images.unsplash.com/photo-1562322140-8baeececf3df?q=80&w=1920&auto=format&fit=crop" 
             alt="Salon" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-luxe-charcoal/80"></div>
    </div>
    <div class="relative z-10 container mx-auto px-6 text-center text-white">
        <p class="section-subtitle text-luxe-gold reveal">Sizi Bekliyoruz</p>
        <h2 class="text-4xl md:text-6xl font-serif mb-8 reveal">Güzellik Yolculuğunuza<br/><span class="italic">Başlayın</span></h2>
        <a href="/Randevu" class="btn-white reveal">RANDEVU AL</a>
    </div>
</section>

@section Scripts {
    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach(el => observer.observe(el));
    </script>
}
